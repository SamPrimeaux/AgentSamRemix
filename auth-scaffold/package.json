    "preview": "npx agentsam identity preview --open"
  },
  "dependencies": {
    "@inneranimalmedia/agentsam-sdk": "^2.0.0-alpha.identity.11"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
