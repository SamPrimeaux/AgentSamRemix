+          activeBranch={activeBranch}
+          activePath={activePath}
+          onBranchChange={onBranchChange}
+          onPathChange={onPathChange}
+          placeholder="Message Agent Sam or pick a task capability..."
+        />
+      </div>
+    </div>
+  );
+};
