+          >
+            <MoreHorizontal size={18} />
+          </button>
+        </div>
+      </div>
+
+      {/* Main Reading Surface Container */}
+      <div className="w-full max-w-2xl mx-auto px-6 pt-6 pb-36 space-y-6 flex-1">
