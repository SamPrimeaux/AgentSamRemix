#!/usr/bin/env node
/**
 * AgentSamRemix host extension for the canonical Agent Sam SDK CLI.
 *
 * Portable commands execute the installed @inneranimalmedia/agentsam-sdk binary.
 * Remix owns only repository/runtime-specific operator verbs under bin/commands/.
 */
import { spawn } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { dirname, resolve } from 'node:path';

import { COMMANDS, usage, resolveVerb } from './commands/index.mjs';

const require = createRequire(import.meta.url);
const SDK_PACKAGE = '@inneranimalmedia/agentsam-sdk';

/** Remix-owned verbs — these override same-named SDK commands when both exist (e.g. deploy). */
const HOST_VERBS = new Set(Object.keys(COMMANDS));

function resolveSdkCli() {
  const packagePath = require.resolve(`${SDK_PACKAGE}/package.json`);
  const packageJson = JSON.parse(readFileSync(packagePath, 'utf8'));
  const relativeCli = typeof packageJson.bin === 'string'
    ? packageJson.bin
    : packageJson.bin?.agentsam;
  if (!relativeCli) throw new Error('agentsam_sdk_cli_missing');
  return resolve(dirname(packagePath), relativeCli);
}

function runSdkCli(argv) {
  return new Promise((resolvePromise, reject) => {
    const child = spawn(process.execPath, [resolveSdkCli(), ...argv], {
      cwd: process.cwd(),
      env: process.env,
      stdio: 'inherit',
    });
    child.once('error', reject);
    child.once('exit', (code, signal) => {
      if (signal) {
        reject(new Error(`agentsam_sdk_cli_signal:${signal}`));
        return;
      }
      process.exitCode = Number(code) || 0;
      resolvePromise();
    });
  });
}

function main(argv) {
  if (!argv.length) {
    usage();
    process.exitCode = 2;
    return;
  }
  if (argv[0] === '--version' || argv[0] === '-v') {
    return runSdkCli(argv);
  }
  if (argv[0] === 'help' || argv[0] === '--help' || argv[0] === '-h') {
    usage();
    return;
  }

  const [verb] = argv;
  const key = resolveVerb(verb);

  if (HOST_VERBS.has(key)) {
    const cmd = COMMANDS[key];
    return cmd(argv.slice(1));
  }

  // All other verbs execute the installed @inneranimalmedia/agentsam-sdk CLI
  // (context, init, status, db, tui, start-local, tunnel, identity, shell, …).
  return runSdkCli(argv);
}

Promise.resolve(main(process.argv.slice(2))).catch((error) => {
  console.error(error?.message || String(error));
  if (error?.payload && process.env.AGENTSAM_DEBUG === '1') {
    console.error(JSON.stringify(error.payload, null, 2));
  }
  process.exitCode = 1;
});
