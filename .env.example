# Copy to .env.local and fill in real values. Never commit .env.local.
# This file is the single source of truth for which secrets exist —
# add a name here BEFORE writing code that reads it, not after.

# --- Agent Sam SDK identity (required) ---
# Default OAuth lane: InnerAnimalMedia IAM.
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=

# --- Developer BYOK OAuth (optional — only if testing non-IAM login) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Transactional email (password reset) ---
RESEND_API_KEY=

# --- Cloudflare bindings ---
# These are declared in wrangler.jsonc, not read from .env in production —
# listed here only so local dev / wrangler.jsonc stays in sync with what's
# actually consumed. Do not add a binding name below without a real
# implementation reading it.
#
# DB              -> D1 database, agentsam-sdk identity tables
# ASSETS          -> R2 bucket, static/build assets
# SESSION_CACHE   -> KV namespace, session lookups
#
# Add binding names here ONLY when an implementation in worker/ consumes them.

# --- Local dev only ---
NODE_ENV=development
