      "mode": "direct",
      "content_type": "text/html; charset=utf-8",
      "cache_control": "public, max-age=0, must-revalidate"
    }
  ],
  "legacy_mutable_keys": [
    "index.html",
    "agentsam-home.html",
    "auth/login.html",
    "auth/signup.html",
    "auth/reset.html",
    "cms/studio-cms-shell.html"
