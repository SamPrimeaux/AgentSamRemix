{
  "name": "flash-lite-browser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,worker -c blue,green \"vite --config app/frontend/vite.config.ts\" \"wrangler dev\"",
    "build": "vite build --config app/frontend/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "test:browser": "node --test test/browser-live-view.test.mjs",
    "test:retrieval": "node --test test/retrieval-v1.test.mjs",
    "eval:retrieval": "node scripts/eval-retrieval-v1.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.87",
    "@cloudflare/ai-chat": "^0.11.0",
    "@cloudflare/codemode": "^0.5.1",
    "@cloudflare/computer": "^0.2.1",
    "@cloudflare/sandbox": "^0.12.9",
    "@cloudflare/shell": "^0.4.3",
    "@cloudflare/think": "^0.17.0",
    "@cloudflare/voice": "^0.4.0",
    "@google/genai": "^1.35.0",
    "@inneranimalmedia/agentsam-sdk": "^2.0.0-alpha.identity.11",
    "@monaco-editor/react": "^4.7.0",
    "agents": "^0.22.0",
    "ai": "^7.0.84",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "lucide-react": "^1.35.0",
    "pg": "^8.20.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@playwright/test": "^1.62.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "chrome-devtools-mcp": "^1.8.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "@inneranimalmedia/agentsam-sdk@2.0.0-alpha.identity.11": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true,
    "node-pty@1.1.0": true,
    "protobufjs@7.6.6": true
  }
}
