{
  "name": "agentsamremix",
  "version": "0.0.1",
  "private": true,
  "description": "Agent Sam Workbench — authenticated operator client for Agent Sam missions.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,worker -c blue,green \"vite\" \"wrangler dev\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "deploy": "npm run build && wrangler deploy",
    "guard": "node scripts/guard-dependency-law.mjs"
  },
  "dependencies": {
    "@inneranimalmedia/agentsam-sdk": "PIN_A_REAL_VERSION_BEFORE_INSTALL",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "@monaco-editor/react": "^4.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.78.0"
  }
}
