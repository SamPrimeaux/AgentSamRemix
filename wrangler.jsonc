{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentsamremix",
  "main": "app/backend/src/index.ts",
  "compatibility_date": "2026-08-29",
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "IAM_CLIENT_ID": "iam_identity_47843d145d72455e83b6",
    "ACP_CLIENT_ID": "iam_dcr_d80b0615148b49de814f",
    "AGENTSAM_MODEL": "@cf/moonshotai/kimi-k2.7-code"
  },
  "ai": {
    "binding": "AGENTSAM_WAI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inneranimalmedia-business",
      "database_id": "cf87b717-d4e2-4cf8-bab0-a81268e32d49"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "08183bb9d2914e87ac8395d7e4ecff60"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "inneranimalmedia"
    },
    {
      "binding": "WEBSITE_ASSETS",
      "bucket_name": "agentsam-os-blueprint-content"
    }
  ],
  "vpc_services": [
    {
      "binding": "PTY_SERVICE",
      "service_id": "019db639-7c70-7071-8ef3-32ec0392a9ff",
      "remote": true
    }
  ],
  "assets": {
    "directory": "./app/frontend/dist",
    "binding": "APP_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/workbench",
      "/api/*",
      "/auth/*",
      "/agents/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AgentSam",
        "class_name": "AgentSam"
      },
      {
        "name": "MY_CONTAINER",
        "class_name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "agentsam-v1",
      "new_sqlite_classes": [
        "AgentSam"
      ]
    },
    {
      "tag": "agentsam-v2",
      "new_sqlite_classes": [
        "Sandbox"
      ]
    }
  ],
  "browser": {
    "binding": "MYBROWSER"
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "services": [
    {
      "binding": "EXECOS",
      "service": "execos"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_CACHE",
      "id": "dc87920b0a9247979a213c09df9a0234"
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "docker.io/cloudflare/sandbox:0.12.9",
      "instance_type": "lite",
      "max_instances": 3
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
