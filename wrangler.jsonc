{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentsamremix",
  "main": "app/backend/src/index.ts",
  "compatibility_date": "2026-08-29",
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "IAM_CLIENT_ID": "iam_identity_47843d145d72455e83b6",
    "ACP_CLIENT_ID": "iam_dcr_d80b0615148b49de814f",
    "AGENTSAM_MODEL": "@cf/moonshotai/kimi-k2.7-code"
  },
  "ai": {
    "binding": "AGENTSAM_WAI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inneranimalmedia-business",
      "database_id": "cf87b717-d4e2-4cf8-bab0-a81268e32d49"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "inneranimalmedia"
    },
    {
      "binding": "WEBSITE_ASSETS",
      "bucket_name": "agentsam-os-blueprint-content"
    }
  ],
  "vpc_services": [
    {
      "binding": "IAM_VPC",
      "service_id": "019db639-7c70-7071-8ef3-32ec0392a9ff",
      "remote": true
    }
  ],
  "assets": {
    "directory": "./app/frontend/dist",
    "binding": "APP_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/workbench",
      "/api/*",
      "/auth/*",
      "/agents/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AgentSam",
        "class_name": "AgentSam"
      }
    ]
  },
  "migrations": [
    {
      "tag": "agentsam-v1",
      "new_sqlite_classes": [
        "AgentSam"
      ]
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ]
}
