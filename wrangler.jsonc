{
  "name": "agentsam-remix-flash-lite",
  "compatibility_date": "2024-03-20",
  "ai": {
    "binding": "AGENTSAM_WAI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_ME",
      "database_id": "REPLACE_ME"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WEBSITE_ASSETS",
      "bucket_name": "REPLACE_ME"
    }
  ],
  "services": [
    {
      "binding": "IAM_VPC",
      "service": "iam-vpc"
    }
  ]
}
