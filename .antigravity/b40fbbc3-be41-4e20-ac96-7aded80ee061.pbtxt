          text: "  fontFamily: \'google-sans\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  geminiModel: \'gemini-3.7-flash\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  autoGrounding: false,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
