    instruction: "Add AgentSam AntiGravity execution environment and telemetry styles to index.css"
    replacement_infos {
      original_chunk {
        target_content: ".tts-voice-lang {\n  font-size: 10px;\n  color: #9aa0a6;\n}"
        replacement_content: ".tts-voice-lang {\n  font-size: 10px;\n  color: #9aa0a6;\n}\n\n/* ==========================================\n   AGENTSAM ANTIGRAVITY EXECUTION LANE STYLES\n   ========================================== */\n\n.app-view-toggle-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 6px 14px;\n  background: #111214;\n  border-bottom: 1px solid #2d2f34;\n  flex-shrink: 0;\n  z-index: 10;\n}\n\n.view-toggle-buttons {\n  display: flex;\n  background: #1e1f23;\n  padding: 3px;\n  border-radius: 8px;\n  border: 1px solid #33363d;\n  gap: 2px;\n}\n\n.view-mode-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 12px;\n  border-radius: 6px;\n  border: none;\n  background: transparent;\n  color: #9aa0a6;\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n}\n\n.view-mode-btn:hover {\n  color: #e8eaed;\n}\n\n.view-mode-btn.active {\n  background: #30343f;\n  color: #8ab4f8;\n  font-weight: 600;\n  box-shadow: 0 1px 4px rgba(0,0,0,0.3);\n}\n\n.view-mode-badge {\n  font-size: 10px;\n  padding: 1px 5px;\n  border-radius: 4px;\n  background: rgba(138, 180, 248, 0.2);\n  color: #8ab4f8;\n}\n\n.agentsam-env-root {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  width: 100%;\n  background: #0d0e11;\n  color: #e8eaed;\n  overflow: hidden;\n  font-family: \'Google Sans Flex\', \'Google Sans\', -apple-system, BlinkMacSystemFont, sans-serif;\n}\n\n.agentsam-header {\n  background: #14161b;\n  border-bottom: 1px solid #252830;\n  padding: 12px 18px 10px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  flex-shrink: 0;\n}\n\n.agentsam-brand-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n}\n\n.agentsam-logo-group {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.agentsam-hex-icon {\n  width: 34px;\n  height: 34px;\n  background: linear-gradient(135deg, #1a73e8, #8ab4f8);\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #fff;\n  box-shadow: 0 0 12px rgba(138, 180, 248, 0.4);\n}\n\n.agentsam-brand-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: #fff;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  letter-spacing: -0.2px;\n}\n\n.agentsam-badge-tag {\n  font-size: 10px;\n  background: rgba(138, 180, 248, 0.15);\n  color: #8ab4f8;\n  border: 1px solid rgba(138, 180, 248, 0.3);\n  padding: 1px 6px;\n  border-radius: 4px;\n  letter-spacing: 0.5px;\n  font-weight: 600;\n}\n\n.agentsam-brand-desc {\n  font-size: 11px;\n  color: #9aa0a6;\n}\n\n.agentsam-top-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.agentsam-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 12px;\n  border-radius: 6px;\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  border: none;\n  font-family: inherit;\n  transition: all 0.15s ease;\n  user-select: none;\n}\n\n.agentsam-btn.primary {\n  background: #1a73e8;\n  color: #fff;\n}\n.agentsam-btn.primary:hover {\n  background: #1b66ca;\n}\n\n.agentsam-btn.secondary {\n  background: #2b2e36;\n  color: #e8eaed;\n  border: 1px solid #3c404b;\n}\n.agentsam-btn.secondary:hover {\n  background: #373b45;\n}\n\n.agentsam-btn.warning {\n  background: #f2994a;\n  color: #121212;\n}\n\n.agentsam-btn.outline {\n  background: transparent;\n  color: #c4c7cc;\n  border: 1px solid #3c404b;\n}\n.agentsam-btn.outline:hover {\n  background: #252830;\n  color: #fff;\n}\n\n.agentsam-btn.icon-only {\n  padding: 6px 8px;\n  background: #2b2e36;\n  color: #e8eaed;\n  border: 1px solid #3c404b;\n}\n\n.agentsam-btn.text-only {\n  background: transparent;\n  color: #f28b82;\n  font-weight: 600;\n}\n.agentsam-btn.text-only:hover {\n  background: rgba(242, 139, 130, 0.15);\n}\n\n.agentsam-controls-bar {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  flex-wrap: wrap;\n}\n\n.agentsam-control-group {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.agentsam-ctrl-label {\n  font-size: 9px;\n  font-weight: 600;\n  color: #80868b;\n  letter-spacing: 0.5px;\n}\n\n.agentsam-select {\n  background: #20232a;\n  border: 1px solid #383c47;\n  color: #e8eaed;\n  padding: 5px 8px;\n  border-radius: 6px;\n  font-size: 12px;\n  outline: none;\n  font-family: inherit;\n  min-width: 220px;\n}\n\n.agentsam-backend-pill-group {\n  display: flex;\n  background: #20232a;\n  border: 1px solid #383c47;\n  padding: 2px;\n  border-radius: 6px;\n  gap: 2px;\n}\n\n.agentsam-backend-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 4px 8px;\n  border-radius: 4px;\n  background: transparent;\n  border: none;\n  color: #9aa0a6;\n  font-size: 11px;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n}\n\n.agentsam-backend-pill:hover {\n  color: #e8eaed;\n}\n\n.agentsam-backend-pill.active {\n  background: #373b45;\n  color: #8ab4f8;\n  font-weight: 600;\n}\n\n.backend-badge {\n  font-size: 9px;\n  background: #181a1f;\n  padding: 1px 4px;\n  border-radius: 3px;\n  color: #81c995;\n}\n\n.agentsam-speed-toggles {\n  display: flex;\n  background: #20232a;\n  border: 1px solid #383c47;\n  border-radius: 4px;\n  padding: 1px;\n}\n\n.agentsam-speed-chip {\n  padding: 3px 6px;\n  border: none;\n  background: transparent;\n  color: #9aa0a6;\n  font-size: 10px;\n  font-weight: 500;\n  cursor: pointer;\n  border-radius: 3px;\n}\n.agentsam-speed-chip.active {\n  background: #8ab4f8;\n  color: #121212;\n  font-weight: 600;\n}\n\n/* Env Spec Banner */\n.agentsam-env-spec-card {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  background: #17191f;\n  border-bottom: 1px solid #282c35;\n  padding: 8px 18px;\n  gap: 16px;\n  font-size: 11px;\n  flex-shrink: 0;\n}\n\n.spec-item.main {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.spec-icon {\n  width: 28px;\n  height: 28px;\n  border-radius: 6px;\n  background: #252932;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #8ab4f8;\n}\n\n.spec-title {\n  font-weight: 600;\n  color: #fff;\n}\n\n.spec-sub {\n  color: #9aa0a6;\n  font-size: 10px;\n}\n\n.spec-metrics-grid {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n}\n\n.spec-col {\n  display: flex;\n  flex-direction: column;\n}\n\n.spec-lbl {\n  font-size: 9px;\n  color: #80868b;\n  font-weight: 600;\n  letter-spacing: 0.3px;\n}\n\n.spec-val {\n  color: #e8eaed;\n  font-weight: 500;\n}\n\n.spec-val.highlight {\n  color: #81c995;\n  font-weight: 600;\n}\n\n/* Main Grid */\n.agentsam-main-grid {\n  display: grid;\n  grid-template-columns: 1fr 310px;\n  flex: 1;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.agentsam-stream-pane {\n  display: flex;\n  flex-direction: column;\n  border-right: 1px solid #252830;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.pane-tabs-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 8px 16px;\n  background: #14161c;\n  border-bottom: 1px solid #252830;\n  flex-shrink: 0;\n}\n\n.pane-tab {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 10px;\n  background: transparent;\n  border: none;\n  color: #9aa0a6;\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  border-radius: 6px;\n  transition: all 0.15s ease;\n  font-family: inherit;\n}\n\n.pane-tab:hover {\n  color: #e8eaed;\n}\n\n.pane-tab.active {\n  background: #252830;\n  color: #8ab4f8;\n  font-weight: 600;\n}\n\n.tab-pill-done {\n  font-size: 9px;\n  background: #1b5e20;\n  color: #a7f3d0;\n  padding: 1px 5px;\n  border-radius: 4px;\n  font-weight: 600;\n}\n\n.pulse-indicator {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.pulse-dot {\n  width: 8px;\n  height: 8px;\n  background: #8ab4f8;\n  border-radius: 50%;\n  box-shadow: 0 0 8px #8ab4f8;\n  animation: pulse-ring 1.5s infinite ease-out;\n}\n\n@keyframes pulse-ring {\n  0% { transform: scale(0.9); opacity: 1; }\n  50% { transform: scale(1.3); opacity: 0.5; }\n  100% { transform: scale(0.9); opacity: 1; }\n}\n\n.agentsam-stream-scroll {\n  flex: 1;\n  overflow-y: auto;\n  padding: 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.mission-prompt-card {\n  background: #16181f;\n  border: 1px solid #282c37;\n  border-radius: 8px;\n  padding: 12px;\n}\n\n.mission-prompt-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 8px;\n}\n\n.mission-prompt-text {\n  font-family: \'Google Sans Mono\', monospace;\n  font-size: 11px;\n  color: #a6adb8;\n  line-height: 1.5;\n  margin: 0;\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n.empty-stream-state {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 60px 20px;\n  color: #9aa0a6;\n}\n\n.stream-steps-list {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.step-card {\n  background: #171920;\n  border: 1px solid #2a2e39;\n  border-radius: 8px;\n  overflow: hidden;\n  transition: border-color 0.15s ease;\n}\n\n.step-card:hover {\n  border-color: #3f4453;\n}\n\n.step-card-header {\n  display: flex;\n  align-items: center;\n  padding: 10px 14px;\n  gap: 10px;\n  cursor: pointer;\n  user-select: none;\n  background: #191c24;\n}\n\n.step-number-badge {\n  font-size: 10px;\n  font-family: \'Google Sans Mono\', monospace;\n  color: #80868b;\n  font-weight: 600;\n  width: 24px;\n}\n\n.step-phase-icon {\n  width: 24px;\n  height: 24px;\n  border-radius: 5px;\n  background: #252934;\n  color: #8ab4f8;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 16px;\n  flex-shrink: 0;\n}\n\n.step-title-group {\n  flex: 1;\n  min-width: 0;\n}\n\n.step-title {\n  font-size: 13px;\n  font-weight: 600;\n  color: #e8eaed;\n}\n\n.step-meta {\n  font-size: 10px;\n  color: #80868b;\n  display: flex;\n  gap: 6px;\n  margin-top: 2px;\n}\n\n.step-expand-btn {\n  background: transparent;\n  border: none;\n  color: #80868b;\n  cursor: pointer;\n  padding: 2px;\n  display: flex;\n}\n\n.step-card-body {\n  padding: 12px 14px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  border-top: 1px solid #232731;\n  background: #14161d;\n}\n\n.thought-box {\n  background: #181b23;\n  border-left: 3px solid #8ab4f8;\n  border-radius: 0 6px 6px 0;\n  padding: 8px 12px;\n}\n\n.thought-label {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 10px;\n  font-weight: 600;\n  color: #8ab4f8;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  margin-bottom: 4px;\n}\n\n.thought-content {\n  font-size: 12px;\n  color: #c4c7cc;\n  line-height: 1.5;\n  white-space: pre-wrap;\n}\n\n.terminal-block {\n  background: #0f1014;\n  border: 1px solid #2a2e38;\n  border-radius: 6px;\n  overflow: hidden;\n  font-family: \'Google Sans Mono\', monospace;\n}\n\n.terminal-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 6px 10px;\n  background: #181a21;\n  border-bottom: 1px solid #252832;\n  font-size: 10px;\n}\n\n.term-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n}\n.term-dot.red { background: #ea4335; }\n.term-dot.yellow { background: #fbbc04; }\n.term-dot.green { background: #34a853; }\n\n.term-cwd {\n  color: #80868b;\n  margin-left: 4px;\n}\n\n.term-status-tag {\n  color: #81c995;\n}\n\n.terminal-cmd-line {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 10px;\n  color: #8ab4f8;\n  font-size: 12px;\n  background: #111318;\n}\n\n.term-prompt {\n  color: #34a853;\n  font-weight: bold;\n}\n\n.terminal-stdout {\n  margin: 0;\n  padding: 8px 10px;\n  font-size: 11px;\n  color: #d1d5db;\n  line-height: 1.4;\n  max-height: 220px;\n  overflow-y: auto;\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n.network-log-card {\n  background: #161a22;\n  border: 1px solid #2d3444;\n  border-radius: 6px;\n  padding: 8px 12px;\n  font-size: 11px;\n}\n\n.network-log-top {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 4px;\n}\n\n.net-method {\n  font-weight: 700;\n  color: #34a853;\n  font-family: monospace;\n}\n\n.net-host {\n  font-weight: 600;\n  color: #8ab4f8;\n  font-family: monospace;\n}\n\n.net-allowed-pill {\n  font-size: 9px;\n  font-weight: 700;\n  padding: 1px 6px;\n  border-radius: 3px;\n}\n.net-allowed-pill.allowed {\n  background: rgba(52, 168, 83, 0.15);\n  color: #81c995;\n  border: 1px solid rgba(52, 168, 83, 0.3);\n}\n\n.net-endpoint {\n  font-family: monospace;\n  color: #9aa0a6;\n  margin-bottom: 4px;\n}\n\n.net-reason {\n  color: #c4c7cc;\n  font-size: 11px;\n}\n\n.file-diff-card {\n  background: #161820;\n  border: 1px solid #292d39;\n  border-radius: 6px;\n  padding: 8px 12px;\n}\n\n.file-diff-top {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11px;\n  color: #8ab4f8;\n  margin-bottom: 6px;\n}\n\n.file-diff-path {\n  font-weight: 600;\n  font-family: monospace;\n}\n\n.file-diff-lines {\n  margin-left: auto;\n  color: #80868b;\n  font-size: 10px;\n}\n\n.file-diff-snippet {\n  margin: 0;\n  padding: 6px 8px;\n  background: #0f1015;\n  border-radius: 4px;\n  font-family: monospace;\n  font-size: 10px;\n  color: #f28b82;\n  white-space: pre-wrap;\n}\n\n/* Tab Contents: Network, Artifacts, Benchmark */\n.agentsam-tab-content {\n  flex: 1;\n  overflow-y: auto;\n  padding: 18px;\n}\n\n.network-header-box {\n  background: #161922;\n  border: 1px solid #282e3d;\n  padding: 12px 16px;\n  border-radius: 8px;\n  margin-bottom: 16px;\n}\n\n.allowlist-table-container {\n  background: #15171e;\n  border: 1px solid #272a35;\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.allowlist-table {\n  width: 100%;\n  border-collapse: collapse;\n  text-align: left;\n}\n\n.allowlist-table th {\n  background: #1b1e27;\n  color: #80868b;\n  font-size: 10px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  padding: 8px 12px;\n  border-bottom: 1px solid #272a35;\n}\n\n.allowlist-table td {\n  padding: 10px 12px;\n  border-bottom: 1px solid #20232c;\n}\n\n.status-badge-pass {\n  font-size: 10px;\n  font-weight: 700;\n  background: rgba(52, 168, 83, 0.15);\n  color: #81c995;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.status-badge-block {\n  font-size: 10px;\n  font-weight: 700;\n  background: rgba(234, 67, 53, 0.15);\n  color: #f28b82;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.artifact-heading {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 14px;\n  font-weight: 600;\n  color: #fff;\n  margin: 0 0 10px;\n}\n\n.svg-diagram-wrapper {\n  background: #131416;\n  border: 1px solid #292c34;\n  border-radius: 8px;\n  padding: 12px;\n  overflow-x: auto;\n}\n\n.consolidation-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.consolidation-card {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  background: #171922;\n  border: 1px solid #282c3a;\n  border-radius: 6px;\n  padding: 10px 14px;\n}\n\n.cons-num {\n  font-size: 11px;\n  font-weight: 700;\n  color: #8ab4f8;\n  width: 65px;\n}\n\n.cons-body {\n  flex: 1;\n}\n\n.cons-title {\n  font-size: 12px;\n  font-weight: 600;\n  color: #e8eaed;\n}\n\n.cons-desc {\n  font-size: 11px;\n  color: #9aa0a6;\n  margin-top: 2px;\n}\n\n.cons-risk {\n  font-size: 10px;\n  font-weight: 700;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n.cons-risk.risk-low {\n  background: rgba(52, 168, 83, 0.15);\n  color: #81c995;\n}\n.cons-risk.risk-medium {\n  background: rgba(251, 188, 4, 0.15);\n  color: #fbbc04;\n}\n\n.issues-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 8px;\n}\n\n.issue-card {\n  background: #181a23;\n  border: 1px solid #2a2e3c;\n  border-left: 3px solid #ea4335;\n  border-radius: 0 6px 6px 0;\n  padding: 10px 14px;\n}\n\n.issue-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 4px;\n}\n\n.issue-severity {\n  font-size: 9px;\n  font-weight: 700;\n  padding: 1px 5px;\n  border-radius: 3px;\n}\n.issue-severity.sev-critical { background: #ea4335; color: #fff; }\n.issue-severity.sev-high { background: #f2994a; color: #121212; }\n.issue-severity.sev-medium { background: #fbbc04; color: #121212; }\n\n.issue-comp {\n  font-weight: 600;\n  font-size: 11px;\n  color: #e8eaed;\n}\n\n.issue-file {\n  font-family: monospace;\n  font-size: 10px;\n  color: #80868b;\n  margin-left: auto;\n}\n\n.issue-desc {\n  font-size: 11px;\n  color: #c4c7cc;\n  margin: 0 0 4px;\n}\n\n.issue-recom {\n  font-size: 11px;\n  color: #8ab4f8;\n}\n\n/* Benchmark Matrix */\n.benchmark-matrix-table-wrap {\n  background: #161821;\n  border: 1px solid #282c39;\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.benchmark-matrix-table {\n  width: 100%;\n  border-collapse: collapse;\n  text-align: left;\n}\n\n.benchmark-matrix-table th {\n  background: #1b1e2a;\n  color: #80868b;\n  font-size: 10px;\n  font-weight: 600;\n  text-transform: uppercase;\n  padding: 10px 12px;\n  border-bottom: 1px solid #282c39;\n}\n\n.benchmark-matrix-table td {\n  padding: 10px 12px;\n  border-bottom: 1px solid #222530;\n}\n\n.benchmark-matrix-table tr.row-selected td {\n  background: rgba(138, 180, 248, 0.08);\n}\n\n.benchmark-insight-box {\n  background: #151822;\n  border: 1px solid #252a3a;\n  padding: 12px 14px;\n  border-radius: 8px;\n}\n\n/* RIGHT COLUMN TELEMETRY COCKPIT */\n.agentsam-telemetry-pane {\n  background: #121318;\n  padding: 14px;\n  display: flex;\n  flex-direction: column;\n  overflow-y: auto;\n  gap: 12px;\n}\n\n.telemetry-header {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding-bottom: 8px;\n  border-bottom: 1px solid #252830;\n}\n\n.telemetry-metrics-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.metric-box {\n  background: #181a22;\n  border: 1px solid #282c39;\n  border-radius: 6px;\n  padding: 8px 10px;\n}\n\n.metric-lbl {\n  font-size: 9px;\n  font-weight: 600;\n  color: #80868b;\n  letter-spacing: 0.5px;\n}\n\n.metric-val {\n  font-size: 16px;\n  font-weight: 600;\n  margin: 2px 0;\n}\n\n.metric-sub-bar {\n  font-size: 10px;\n  color: #80868b;\n  display: flex;\n  gap: 8px;\n  margin-top: 2px;\n}\n\n.pricing-ref-card {\n  background: #161820;\n  border: 1px solid #262935;\n  border-radius: 6px;\n  padding: 10px;\n  font-size: 11px;\n}\n\n.pricing-ref-title {\n  font-weight: 600;\n  color: #8ab4f8;\n  margin-bottom: 6px;\n}\n\n.pricing-row {\n  display: flex;\n  justify-content: space-between;\n  color: #9aa0a6;\n  margin-bottom: 4px;\n}\n\n.pricing-row.highlight {\n  color: #81c995;\n  border-top: 1px dashed #303440;\n  padding-top: 4px;\n  margin-top: 4px;\n}\n\n.quick-actions-box {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.quick-action-btn {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 10px;\n  background: #191b24;\n  border: 1px solid #282c3b;\n  border-radius: 6px;\n  color: #c4c7cc;\n  font-size: 11px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  text-align: left;\n  font-family: inherit;\n}\n\n.quick-action-btn:hover {\n  background: #252836;\n  color: #fff;\n  border-color: #3b4255;\n}\n"
