      target_content: "  /* -- STATUS BAR -- */\n  .status-bar {\n    font-size: 11px;\n    padding: 2px 8px;\n  }\n}"
      replacement_content: "  /* -- STATUS BAR -- */\n  .status-bar {\n    font-size: 11px;\n    padding: 2px 8px;\n  }\n}\n\n/* ==========================================\n   TEXT-TO-SPEECH (TTS) STYLES\n   ========================================== */\n\n.tts-nav-btn {\n  position: relative;\n  transition: all 0.2s ease;\n}\n\n.tts-nav-btn.active-speaking {\n  color: #8ab4f8;\n  background: rgba(138, 180, 248, 0.15);\n  box-shadow: 0 0 8px rgba(138, 180, 248, 0.35);\n  animation: tts-pulse 2s infinite ease-in-out;\n}\n\n@keyframes tts-pulse {\n  0%, 100% {\n    box-shadow: 0 0 4px rgba(138, 180, 248, 0.2);\n  }\n  50% {\n    box-shadow: 0 0 10px rgba(138, 180, 248, 0.5);\n  }\n}\n\n.dropdown-menu-btn {\n  width: 100%;\n  border: none;\n  background: transparent;\n  text-align: left;\n  font-family: inherit;\n}\n\n.dropdown-menu-btn.disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n.tts-menu-badge {\n  font-size: 11px;\n  padding: 2px 6px;\n  border-radius: 4px;\n  background: #3c4043;\n  color: #8ab4f8;\n  font-weight: 500;\n}\n\n.tts-player-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 6px 12px;\n  background: #202124;\n  border-bottom: 1px solid #3c4043;\n  color: #e8eaed;\n  font-size: 13px;\n  z-index: 50;\n  animation: tts-slide-down 0.2s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n@keyframes tts-slide-down {\n  from {\n    transform: translateY(-8px);\n    opacity: 0;\n  }\n  to {\n    transform: translateY(0);\n    opacity: 1;\n  }\n}\n\n.tts-player-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  flex: 1;\n}\n\n.tts-player-right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n/* Waveform animation */\n.tts-waveform {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  height: 16px;\n  padding: 0 2px;\n}\n\n.tts-wave-bar {\n  width: 3px;\n  height: 4px;\n  background: #8ab4f8;\n  border-radius: 1.5px;\n  transition: height 0.15s ease;\n}\n\n.tts-waveform.playing .tts-wave-bar:nth-child(1) {\n  animation: tts-bar-bounce 0.8s ease-in-out infinite alternate;\n}\n.tts-waveform.playing .tts-wave-bar:nth-child(2) {\n  animation: tts-bar-bounce 0.8s ease-in-out infinite alternate 0.2s;\n}\n.tts-waveform.playing .tts-wave-bar:nth-child(3) {\n  animation: tts-bar-bounce 0.8s ease-in-out infinite alternate 0.4s;\n}\n.tts-waveform.playing .tts-wave-bar:nth-child(4) {\n  animation: tts-bar-bounce 0.8s ease-in-out infinite alternate 0.1s;\n}\n\n@keyframes tts-bar-bounce {\n  0% { height: 3px; opacity: 0.6; }\n  100% { height: 15px; opacity: 1; }\n}\n\n.tts-waveform.paused .tts-wave-bar {\n  opacity: 0.4;\n  height: 4px;\n}\n\n/* Control buttons */\n.tts-ctrl-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  border: none;\n  background: #303134;\n  color: #e8eaed;\n  cursor: pointer;\n  padding: 0;\n  transition: all 0.15s ease;\n  user-select: none;\n  flex-shrink: 0;\n}\n\n.tts-ctrl-btn:hover {\n  background: #3c4043;\n  color: #fff;\n}\n\n.tts-ctrl-btn.primary {\n  background: #8ab4f8;\n  color: #202124;\n}\n\n.tts-ctrl-btn.primary:hover {\n  background: #aecbfa;\n}\n\n.tts-ctrl-btn .material-symbols-outlined {\n  font-size: 18px;\n}\n\n.tts-ctrl-btn.close-btn {\n  background: transparent;\n  color: #9aa0a6;\n}\n\n.tts-ctrl-btn.close-btn:hover {\n  background: #3c4043;\n  color: #e8eaed;\n}\n\n/* Info container */\n.tts-info {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  flex: 1;\n}\n\n.tts-status-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11px;\n}\n\n.tts-status-tag {\n  color: #8ab4f8;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n}\n\n.tts-chunk-count {\n  color: #9aa0a6;\n}\n\n.tts-snippet {\n  font-size: 12px;\n  color: #c4c7cc;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  max-width: 420px;\n}\n\n/* Speed selector */\n.tts-speed-selector {\n  display: flex;\n  background: #303134;\n  border-radius: 14px;\n  padding: 2px;\n  gap: 1px;\n}\n\n.tts-speed-btn {\n  border: none;\n  background: transparent;\n  color: #9aa0a6;\n  font-size: 11px;\n  font-weight: 500;\n  padding: 2px 6px;\n  border-radius: 12px;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.tts-speed-btn:hover {\n  color: #e8eaed;\n}\n\n.tts-speed-btn.active {\n  background: #8ab4f8;\n  color: #202124;\n}\n\n/* Voice picker dropdown */\n.tts-voice-container {\n  position: relative;\n}\n\n.tts-voice-btn.active {\n  background: #3c4043;\n  color: #8ab4f8;\n}\n\n.tts-voice-menu {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  margin-top: 6px;\n  background: #292a2d;\n  border: 1px solid #3c4043;\n  border-radius: 8px;\n  padding: 6px 0;\n  min-width: 240px;\n  max-width: 320px;\n  max-height: 240px;\n  overflow-y: auto;\n  z-index: 120;\n  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.5);\n}\n\n.tts-voice-menu-header {\n  padding: 4px 12px 6px;\n  font-size: 11px;\n  font-weight: 600;\n  color: #9aa0a6;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  border-bottom: 1px solid #3c4043;\n}\n\n.tts-voice-list {\n  display: flex;\n  flex-direction: column;\n}\n\n.tts-voice-item {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  width: 100%;\n  padding: 8px 12px;\n  border: none;\n  background: transparent;\n  color: #e8eaed;\n  text-align: left;\n  cursor: pointer;\n  transition: background 0.1s ease;\n  font-size: 12px;\n}\n\n.tts-voice-item:hover {\n  background: #35363a;\n}\n\n.tts-voice-item.selected {\n  background: rgba(138, 180, 248, 0.15);\n  color: #8ab4f8;\n  font-weight: 500;\n}\n\n.tts-voice-name {\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  width: 100%;\n}\n\n.tts-voice-lang {\n  font-size: 10px;\n  color: #9aa0a6;\n}\n"
    }
