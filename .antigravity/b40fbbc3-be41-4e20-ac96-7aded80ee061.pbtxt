  file_change {
    absolute_path_uri: "file:///components/AgentSamEnvironment.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef, useMemo } from \'react\';\nimport {\n  BackendType,\n  BACKEND_CONFIGS,\n  MissionStep,\n  MissionReport,\n  PresetMission,\n} from \'../types/agentSam\';\nimport { PRESET_MISSIONS, generateStepsForMission } from \'../data/missionPresets\';\n\ninterface AgentSamEnvironmentProps {\n  onSwitchToBrowser?: () => void;\n}\n\nexport const AgentSamEnvironment: React.FC<AgentSamEnvironmentProps> = ({ onSwitchToBrowser }) => {\n  // State\n  const [selectedBackend, setSelectedBackend] = useState<BackendType>(\'antigravity\');\n  const [selectedMissionId, setSelectedMissionId] = useState<string>(\'identity-authority-audit\');\n  const [customPrompt, setCustomPrompt] = useState<string>(\'\');\n  const [isCustomMode, setIsCustomMode] = useState<boolean>(false);\n\n  // Execution state\n  const [isRunning, setIsRunning] = useState<boolean>(false);\n  const [isPaused, setIsPaused] = useState<boolean>(false);\n  const [currentStepIndex, setCurrentStepIndex] = useState<number>(0);\n  const [expandedStepIds, setExpandedStepIds] = useState<Record<string, boolean>>({});\n  const [activeTab, setActiveTab] = useState<\'stream\' | \'network\' | \'artifacts\' | \'benchmark\'>(\'stream\');\n  const [playbackSpeed, setPlaybackSpeed] = useState<number>(1); // 1x, 2x, 4x, 0 = instant\n\n  const streamEndRef = useRef<HTMLDivElement>(null);\n  const stepTimerRef = useRef<number | null>(null);\n\n  // Selected mission definition\n  const currentMission = useMemo(() => {\n    return PRESET_MISSIONS.find(m => m.id === selectedMissionId) || PRESET_MISSIONS[0];\n  }, [selectedMissionId]);\n\n  // Generated steps & report for current backend & mission\n  const { steps: allSteps, report: missionReport } = useMemo(() => {\n    return generateStepsForMission(selectedMissionId, selectedBackend);\n  }, [selectedMissionId, selectedBackend]);\n\n  // Steps to display based on progress\n  const visibleSteps = useMemo(() => {\n    return allSteps.slice(0, currentStepIndex);\n  }, [allSteps, currentStepIndex]);\n\n  // Cumulative token and cost metrics\n  const telemetry = useMemo(() => {\n    let input = 0;\n    let output = 0;\n    let thinking = 0;\n    let durationMs = 0;\n    let toolCallsCount = 0;\n    let terminalCallsCount = 0;\n\n    visibleSteps.forEach(s => {\n      input += s.tokens.input;\n      output += s.tokens.output;\n      thinking += s.tokens.thinking;\n      durationMs += s.durationMs;\n      if (s.phase === \'tool_call\' || s.phase === \'fileDiff\') toolCallsCount++;\n      if (s.terminal) terminalCallsCount++;\n    });\n\n    const totalTokens = input + output + thinking;\n    // Gemini 3.7 Flash: $0.75/M in, $3.75/M out (incl thinking)\n    const modelCost = ((input / 1_000_000) * 0.75) + (((output + thinking) / 1_000_000) * 3.75);\n    const computeHours = durationMs / (1000 * 60 * 60);\n    const computeCost = selectedBackend === \'antigravity\'\n      ? 0.0\n      : computeHours * BACKEND_CONFIGS[selectedBackend].computeCostPerHour;\n\n    return {\n      input,\n      output,\n      thinking,\n      totalTokens,\n      durationMs,\n      toolCallsCount,\n      terminalCallsCount,\n      modelCost,\n      computeCost,\n      totalCost: modelCost + computeCost,\n      isCompleted: currentStepIndex >= allSteps.length,\n    };\n  }, [visibleSteps, selectedBackend, currentStepIndex, allSteps.length]);\n\n  // Auto-expand newly appearing steps\n  useEffect(() => {\n    if (visibleSteps.length > 0) {\n      const latestStep = visibleSteps[visibleSteps.length - 1];\n      setExpandedStepIds(prev => ({\n        ...prev,\n        [latestStep.id]: true,\n      }));\n    }\n  }, [visibleSteps.length]);\n\n  // Auto-scroll stream to bottom when running\n  useEffect(() => {\n    if (isRunning && streamEndRef.current) {\n      streamEndRef.current.scrollIntoView({ behavior: \'smooth\' });\n    }\n  }, [visibleSteps.length, isRunning]);\n\n  // Execution loop timer\n  useEffect(() => {\n    if (!isRunning || isPaused) {\n      if (stepTimerRef.current) clearTimeout(stepTimerRef.current);\n      return;\n    }\n\n    if (currentStepIndex >= allSteps.length) {\n      setIsRunning(false);\n      return;\n    }\n\n    const currentStep = allSteps[currentStepIndex];\n    const delay = playbackSpeed === 0 ? 50 : Math.max(250, currentStep.durationMs / playbackSpeed);\n\n    stepTimerRef.current = window.setTimeout(() => {\n      setCurrentStepIndex(prev => prev + 1);\n    }, delay);\n\n    return () => {\n      if (stepTimerRef.current) clearTimeout(stepTimerRef.current);\n    };\n  }, [isRunning, isPaused, currentStepIndex, allSteps, playbackSpeed]);\n\n  // Handlers\n  const handleStartMission = () => {\n    setCurrentStepIndex(1);\n    setIsRunning(true);\n    setIsPaused(false);\n  };\n\n  const handlePauseResume = () => {\n    setIsPaused(prev => !prev);\n  };\n\n  const handleStepForward = () => {\n    if (currentStepIndex < allSteps.length) {\n      setCurrentStepIndex(prev => prev + 1);\n    }\n  };\n\n  const handleReset = () => {\n    setIsRunning(false);\n    setIsPaused(false);\n    setCurrentStepIndex(0);\n    setExpandedStepIds({});\n  };\n\n  const handleRunAllInstant = () => {\n    setCurrentStepIndex(allSteps.length);\n    setIsRunning(false);\n    setIsPaused(false);\n    // expand all steps\n    const allExp: Record<string, boolean> = {};\n    allSteps.forEach(s => {\n      allExp[s.id] = true;\n    });\n    setExpandedStepIds(allExp);\n  };\n\n  const toggleStepExpand = (stepId: string) => {\n    setExpandedStepIds(prev => ({\n      ...prev,\n      [stepId]: !prev[stepId],\n    }));\n  };\n\n  const backendConfig = BACKEND_CONFIGS[selectedBackend];\n\n  return (\n    <div className=\"agentsam-env-root\">\n      {/* Top Banner / Navigation */}\n      <header className=\"agentsam-header\">\n        <div className=\"agentsam-brand-row\">\n          <div className=\"agentsam-logo-group\">\n            <div className=\"agentsam-hex-icon\">\n              <span className=\"material-symbols-outlined\">terminal</span>\n            </div>\n            <div>\n              <div className=\"agentsam-brand-title\">\n                AgentSam AntiGravity <span className=\"agentsam-badge-tag\">EXECUTION LANE</span>\n              </div>\n              <div className=\"agentsam-brand-desc\">\n                Autonomous multi-backend harness & telemetry benchmarker (Cloudflare vs Google Antigravity)\n              </div>\n            </div>\n          </div>\n\n          <div className=\"agentsam-top-actions\">\n            {onSwitchToBrowser && (\n              <button\n                onClick={onSwitchToBrowser}\n                className=\"agentsam-btn outline\"\n                title=\"Switch back to Browser Simulation\"\n              >\n                <span className=\"material-symbols-outlined\">language</span>\n                <span>Browser UI</span>\n              </button>\n            )}\n            <button\n              onClick={() => {\n                const json = JSON.stringify({ mission: currentMission, telemetry, steps: visibleSteps }, null, 2);\n                navigator.clipboard.writeText(json);\n                alert(\'Mission Telemetry copied to clipboard!\');\n              }}\n              className=\"agentsam-btn outline\"\n              title=\"Copy JSON Telemetry\"\n            >\n              <span className=\"material-symbols-outlined\">content_copy</span>\n              <span>Export Telemetry</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Control Toolbar */}\n        <div className=\"agentsam-controls-bar\">\n          {/* Mission Selector */}\n          <div className=\"agentsam-control-group\">\n            <label className=\"agentsam-ctrl-label\">MISSION</label>\n            <select\n              value={selectedMissionId}\n              disabled={isRunning}\n              onChange={(e) => {\n                setSelectedMissionId(e.target.value);\n                handleReset();\n              }}\n              className=\"agentsam-select\"\n            >\n              {PRESET_MISSIONS.map(m => (\n                <option key={m.id} value={m.id}>{m.title}</option>\n              ))}\n            </select>\n          </div>\n\n          {/* Backend Target Selector */}\n          <div className=\"agentsam-control-group\">\n            <label className=\"agentsam-ctrl-label\">EXECUTION BACKEND</label>\n            <div className=\"agentsam-backend-pill-group\">\n              {(Object.keys(BACKEND_CONFIGS) as BackendType[]).map((key) => {\n                const cfg = BACKEND_CONFIGS[key];\n                const isSelected = selectedBackend === key;\n                return (\n                  <button\n                    key={key}\n                    disabled={isRunning}\n                    onClick={() => {\n                      setSelectedBackend(key);\n                      handleReset();\n                    }}\n                    className={`agentsam-backend-pill ${isSelected ? \'active\' : \'\'}`}\n                    title={`${cfg.name} - ${cfg.tagline}`}\n                  >\n                    <span className=\"backend-name\">{cfg.name.split(\' \')[0]}</span>\n                    <span className=\"backend-badge\">{key === \'antigravity\' ? \'$0 Preview\' : key === \'cloudflare\' ? \'\302\274 vCPU\' : key === \'local_pty\' ? \'Local\' : \'GCP\'}</span>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Run / Controls */}\n          <div className=\"agentsam-control-group playback-group\">\n            <label className=\"agentsam-ctrl-label\">CONTROLS</label>\n            <div className=\"flex items-center gap-2\">\n              {!isRunning && currentStepIndex === 0 ? (\n                <button\n                  onClick={handleStartMission}\n                  className=\"agentsam-btn primary\"\n                  title=\"Execute Mission Step-by-Step\"\n                >\n                  <span className=\"material-symbols-outlined\">play_arrow</span>\n                  <span>Run Mission</span>\n                </button>\n              ) : isRunning ? (\n                <button\n                  onClick={handlePauseResume}\n                  className={`agentsam-btn ${isPaused ? \'warning\' : \'secondary\'}`}\n                  title={isPaused ? \'Resume Mission\' : \'Pause Execution\'}\n                >\n                  <span className=\"material-symbols-outlined\">{isPaused ? \'play_arrow\' : \'pause\'}</span>\n                  <span>{isPaused ? \'Resume\' : \'Pause\'}</span>\n                </button>\n              ) : (\n                <button\n                  onClick={handleReset}\n                  className=\"agentsam-btn secondary\"\n                  title=\"Reset Mission\"\n                >\n                  <span className=\"material-symbols-outlined\">replay</span>\n                  <span>Restart</span>\n                </button>\n              )}\n\n              <button\n                onClick={handleStepForward}\n                disabled={isRunning && !isPaused}\n                className=\"agentsam-btn icon-only\"\n                title=\"Step 1 Action Forward\"\n              >\n                <span className=\"material-symbols-outlined\">skip_next</span>\n              </button>\n\n              <button\n                onClick={handleRunAllInstant}\n                className=\"agentsam-btn text-only\"\n                title=\"Instant Complete & Audit\"\n              >\n                Instant \342\232\241\n              </button>\n\n              {/* Speed dropdown */}\n              <div className=\"agentsam-speed-toggles\">\n                {[1, 2, 4].map(s => (\n                  <button\n                    key={s}\n                    onClick={() => setPlaybackSpeed(s)}\n                    className={`agentsam-speed-chip ${playbackSpeed === s ? \'active\' : \'\'}`}\n                  >\n                    {s}x\n                  </button>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      {/* Target Backend Spec Card Banner */}\n      <div className=\"agentsam-env-spec-card\">\n        <div className=\"spec-item main\">\n          <div className=\"spec-icon\">\n            <span className=\"material-symbols-outlined\">\n              {selectedBackend === \'antigravity\' ? \'cloud_done\' : selectedBackend === \'cloudflare\' ? \'deployed_code\' : selectedBackend === \'local_pty\' ? \'desktop_mac\' : \'dns\'}\n            </span>\n          </div>\n          <div>\n            <div className=\"spec-title\">{backendConfig.name}</div>\n            <div className=\"spec-sub\">{backendConfig.tagline}</div>\n          </div>\n        </div>\n\n        <div className=\"spec-metrics-grid\">\n          <div className=\"spec-col\">\n            <span className=\"spec-lbl\">COMPUTE / CPU</span>\n            <span className=\"spec-val\">{backendConfig.cpu}</span>\n          </div>\n          <div className=\"spec-col\">\n            <span className=\"spec-lbl\">MEMORY & DISK</span>\n            <span className=\"spec-val\">{backendConfig.ram} \342\200\242 {backendConfig.disk}</span>\n          </div>\n          <div className=\"spec-col\">\n            <span className=\"spec-lbl\">COMPUTE BILLING</span>\n            <span className=\"spec-val highlight\">\n              {backendConfig.computeCostPerHour === 0 ? \'$0.00 (Preview Free)\' : `$${backendConfig.computeCostPerHour}/hr`}\n            </span>\n          </div>\n          <div className=\"spec-col\">\n            <span className=\"spec-lbl\">NETWORK POLICY</span>\n            <span className=\"spec-val\">{backendConfig.networkPolicy}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Grid: Left Stream + Right Telemetry / Artifacts */}\n      <div className=\"agentsam-main-grid\">\n        {/* LEFT COLUMN: Execution Stream */}\n        <section className=\"agentsam-stream-pane\">\n          {/* Sub-tabs header */}\n          <div className=\"pane-tabs-header\">\n            <div className=\"flex gap-2\">\n              <button\n                onClick={() => setActiveTab(\'stream\')}\n                className={`pane-tab ${activeTab === \'stream\' ? \'active\' : \'\'}`}\n              >\n                <span className=\"material-symbols-outlined text-sm\">terminal</span>\n                <span>Execution Stream ({visibleSteps.length}/{allSteps.length})</span>\n              </button>\n              <button\n                onClick={() => setActiveTab(\'network\')}\n                className={`pane-tab ${activeTab === \'network\' ? \'active\' : \'\'}`}\n              >\n                <span className=\"material-symbols-outlined text-sm\">public</span>\n                <span>Network & Allowlist ({backendConfig.allowlist.length})</span>\n              </button>\n              <button\n                onClick={() => setActiveTab(\'artifacts\')}\n                className={`pane-tab ${activeTab === \'artifacts\' ? \'active\' : \'\'}`}\n              >\n                <span className=\"material-symbols-outlined text-sm\">hub</span>\n                <span>Architecture & Report {telemetry.isCompleted && <span className=\"tab-pill-done\">Ready</span>}</span>\n              </button>\n              <button\n                onClick={() => setActiveTab(\'benchmark\')}\n                className={`pane-tab ${activeTab === \'benchmark\' ? \'active\' : \'\'}`}\n              >\n                <span className=\"material-symbols-outlined text-sm\">query_stats</span>\n                <span>Backend Comparison</span>\n              </button>\n            </div>\n\n            {/* Status indicator */}\n            <div className=\"flex items-center gap-2\">\n              {isRunning && !isPaused && (\n                <div className=\"pulse-indicator\">\n                  <span className=\"pulse-dot\" />\n                  <span className=\"text-xs text-blue-400\">EXECUTING AUTONOMOUS LOOP</span>\n                </div>\n              )}\n              {isPaused && (\n                <span className=\"text-xs text-amber-400 font-medium\">PAUSED</span>\n              )}\n              {telemetry.isCompleted && (\n                <span className=\"text-xs text-emerald-400 font-medium flex items-center gap-1\">\n                  <span className=\"material-symbols-outlined text-sm\">check_circle</span> MISSION COMPLETE\n                </span>\n              )}\n            </div>\n          </div>\n\n          {/* TAB 1: Stream View */}\n          {activeTab === \'stream\' && (\n            <div className=\"agentsam-stream-scroll\">\n              {/* Mission Prompt Box */}\n              <div className=\"mission-prompt-card\">\n                <div className=\"mission-prompt-header\">\n                  <span className=\"material-symbols-outlined text-base text-sky-400\">assignment</span>\n                  <span className=\"font-semibold text-sm text-gray-200\">{currentMission.title}</span>\n                  <span className=\"text-xs text-gray-400 ml-auto\">Target: {currentMission.targetRepo}</span>\n                </div>\n                <pre className=\"mission-prompt-text\">{currentMission.prompt}</pre>\n              </div>\n\n              {visibleSteps.length === 0 ? (\n                <div className=\"empty-stream-state\">\n                  <span className=\"material-symbols-outlined text-4xl text-gray-600 mb-2\">rocket_launch</span>\n                  <p className=\"text-gray-300 font-medium\">Ready to start autonomous mission.</p>\n                  <p className=\"text-xs text-gray-500 max-w-sm text-center mt-1\">\n                    Click <strong>Run Mission</strong> to spawn the isolated sandbox, execute live AST static checks, run terminal commands, and audit overlapping identity systems.\n                  </p>\n                  <button onClick={handleStartMission} className=\"agentsam-btn primary mt-4\">\n                    <span className=\"material-symbols-outlined\">play_arrow</span> Start Execution\n                  </button>\n                </div>\n              ) : (\n                <div className=\"stream-steps-list\">\n                  {visibleSteps.map((step) => {\n                    const isExpanded = !!expandedStepIds[step.id];\n\n                    return (\n                      <div key={step.id} className={`step-card phase-${step.phase}`}>\n                        {/* Step Header */}\n                        <div\n                          className=\"step-card-header\"\n                          onClick={() => toggleStepExpand(step.id)}\n                          role=\"button\"\n                          tabIndex={0}\n                        >\n                          <div className=\"step-number-badge\">#{step.stepNumber}</div>\n                          \n                          <div className=\"step-phase-icon\">\n                            {step.phase === \'env_init\' && <span className=\"material-symbols-outlined\">memory</span>}\n                            {step.phase === \'thought\' && <span className=\"material-symbols-outlined\">psychology</span>}\n                            {step.phase === \'terminal\' && <span className=\"material-symbols-outlined\">terminal</span>}\n                            {step.phase === \'network_egress\' && <span className=\"material-symbols-outlined\">lan</span>}\n                            {step.phase === \'tool_call\' && <span className=\"material-symbols-outlined\">find_in_page</span>}\n                            {step.phase === \'verification\' && <span className=\"material-symbols-outlined\">fact_check</span>}\n                            {step.phase === \'artifact_generation\' && <span className=\"material-symbols-outlined\">auto_awesome</span>}\n                          </div>\n\n                          <div className=\"step-title-group\">\n                            <div className=\"step-title\">{step.title}</div>\n                            <div className=\"step-meta\">\n                              <span>{step.timestamp}</span>\n                              <span>\342\200\242</span>\n                              <span>{step.durationMs}ms</span>\n                              <span>\342\200\242</span>\n                              <span>{step.tokens.input + step.tokens.output + step.tokens.thinking} tokens</span>\n                            </div>\n                          </div>\n\n                          <button className=\"step-expand-btn\" aria-label=\"Toggle step details\">\n                            <span className=\"material-symbols-outlined\">\n                              {isExpanded ? \'expand_less\' : \'expand_more\'}\n                            </span>\n                          </button>\n                        </div>\n\n                        {/* Step Body (Collapsible / Click to Expand) */}\n                        {isExpanded && (\n                          <div className=\"step-card-body\">\n                            {/* Thought Box */}\n                            {step.thoughtContent && (\n                              <div className=\"thought-box\">\n                                <div className=\"thought-label\">\n                                  <span className=\"material-symbols-outlined text-xs\">psychology</span>\n                                  <span>Agent Reasoning / Chain of Thought</span>\n                                </div>\n                                <div className=\"thought-content\">{step.thoughtContent}</div>\n                              </div>\n                            )}\n\n                            {/* Terminal Execution Block */}\n                            {step.terminal && (\n                              <div className=\"terminal-block\">\n                                <div className=\"terminal-header\">\n                                  <div className=\"flex items-center gap-1.5\">\n                                    <span className=\"term-dot red\" />\n                                    <span className=\"term-dot yellow\" />\n                                    <span className=\"term-dot green\" />\n                                    <span className=\"term-cwd\">{step.terminal.cwd}</span>\n                                  </div>\n                                  <span className=\"term-status-tag\">exit code: {step.terminal.exitCode}</span>\n                                </div>\n                                <div className=\"terminal-cmd-line\">\n                                  <span className=\"term-prompt\">$</span>\n                                  <code>{step.terminal.command}</code>\n                                </div>\n                                <pre className=\"terminal-stdout\">{step.terminal.stdout}</pre>\n                              </div>\n                            )}\n\n                            {/* Network Egress Block */}\n                            {step.network && (\n                              <div className=\"network-log-card\">\n                                <div className=\"network-log-top\">\n                                  <span className=\"net-method\">{step.network.method}</span>\n                                  <span className=\"net-host\">{step.network.host}</span>\n                                  <span className={`net-allowed-pill ${step.network.allowed ? \'allowed\' : \'blocked\'}`}>\n                                    {step.network.allowed ? \'ALLOWLIST PASS\' : \'BLOCKED\'}\n                                  </span>\n                                  <span className=\"net-bytes ml-auto\">{(step.network.bytes / 1024).toFixed(1)} KB</span>\n                                </div>\n                                <div className=\"net-endpoint\">{step.network.endpoint}</div>\n                                <div className=\"net-reason\">\n                                  <strong>Reason:</strong> {step.network.reason}\n                                </div>\n                              </div>\n                            )}\n\n                            {/* File Diff / Inspection */}\n                            {step.fileDiff && (\n                              <div className=\"file-diff-card\">\n                                <div className=\"file-diff-top\">\n                                  <span className=\"material-symbols-outlined text-xs\">description</span>\n                                  <span className=\"file-diff-path\">{step.fileDiff.filePath}</span>\n                                  <span className=\"file-diff-lines\">{step.fileDiff.linesAnalyzed} lines analyzed</span>\n                                </div>\n                                {step.fileDiff.snippet && (\n                                  <pre className=\"file-diff-snippet\">{step.fileDiff.snippet}</pre>\n                                )}\n                              </div>\n                            )}\n                          </div>\n                        )}\n                      </div>\n                    );\n                  })}\n                  <div ref={streamEndRef} />\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* TAB 2: Network & Allowlist */}\n          {activeTab === \'network\' && (\n            <div className=\"agentsam-tab-content network-policy-view\">\n              <div className=\"network-header-box\">\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <span className=\"material-symbols-outlined text-sky-400\">shield_lock</span>\n                  <h3 className=\"text-base font-semibold text-white\">Sandbox Egress Firewall Policy</h3>\n                </div>\n                <p className=\"text-xs text-gray-400\">\n                  Google Antigravity & Cloudflare Containers enforce strict egress allowlists to prevent exfiltration while allowing package registries like <code>files.pythonhosted.org</code> (PyPI) and <code>registry.npmjs.org</code> (npm).\n                </p>\n              </div>\n\n              <div className=\"allowlist-table-container\">\n                <table className=\"allowlist-table\">\n                  <thead>\n                    <tr>\n                      <th>Domain / Destination</th>\n                      <th>Category</th>\n                      <th>Policy Status</th>\n                      <th>Resolved via</th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    {backendConfig.allowlist.map((domain, i) => (\n                      <tr key={i}>\n                        <td className=\"font-mono text-xs text-sky-300 font-semibold\">{domain}</td>\n                        <td className=\"text-xs text-gray-300\">\n                          {domain.includes(\'pythonhosted\') || domain.includes(\'pypi\')\n                            ? \'PyPI Official CDN & Package Mirror\'\n                            : domain.includes(\'npmjs\')\n                            ? \'NPM Public Registry\'\n                            : domain.includes(\'github\')\n                            ? \'Git Source Hosting\'\n                            : domain.includes(\'google\')\n                            ? \'Google AI API Endpoints\'\n                            : \'Runtime Assets\'}\n                        </td>\n                        <td>\n                          <span className=\"status-badge-pass\">ALLOW</span>\n                        </td>\n                        <td className=\"text-xs text-gray-500 font-mono\">Sandbox Gateway Filter</td>\n                      </tr>\n                    ))}\n                    <tr>\n                      <td className=\"font-mono text-xs text-red-300\">0.0.0.0/0 (Arbitrary IPs)</td>\n                      <td className=\"text-xs text-gray-400\">Untrusted Outbound Connections</td>\n                      <td>\n                        <span className=\"status-badge-block\">BLOCK (DROP)</span>\n                      </td>\n                      <td className=\"text-xs text-gray-500 font-mono\">Egress Firewall</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 3: Artifacts & Report */}\n          {activeTab === \'artifacts\' && (\n            <div className=\"agentsam-tab-content artifacts-view\">\n              <div className=\"artifact-section\">\n                <h3 className=\"artifact-heading\">\n                  <span className=\"material-symbols-outlined\">account_tree</span>\n                  <span>Generated Architecture & Authority Overlap Map</span>\n                </h3>\n                <div\n                  className=\"svg-diagram-wrapper\"\n                  dangerouslySetInnerHTML={{ __html: missionReport.architectureSvg }}\n                />\n              </div>\n\n              {/* Consolidation Roadmap */}\n              <div className=\"artifact-section mt-6\">\n                <h3 className=\"artifact-heading\">\n                  <span className=\"material-symbols-outlined\">splitscreen</span>\n                  <span>Proposed 4-Phase Consolidation Sequence</span>\n                </h3>\n                <div className=\"consolidation-list\">\n                  {missionReport.consolidationSequence.map((item) => (\n                    <div key={item.step} className=\"consolidation-card\">\n                      <div className=\"cons-num\">Phase {item.step}</div>\n                      <div className=\"cons-body\">\n                        <div className=\"cons-title\">{item.title}</div>\n                        <div className=\"cons-desc\">{item.detail}</div>\n                      </div>\n                      <div className={`cons-risk risk-${item.risk}`}>{item.risk.toUpperCase()} RISK</div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Issues Audited */}\n              <div className=\"artifact-section mt-6\">\n                <h3 className=\"artifact-heading\">\n                  <span className=\"material-symbols-outlined\">warning</span>\n                  <span>Identified Authority Conflicts ({missionReport.issuesFound.length})</span>\n                </h3>\n                <div className=\"issues-grid\">\n                  {missionReport.issuesFound.map((issue) => (\n                    <div key={issue.id} className=\"issue-card\">\n                      <div className=\"issue-header\">\n                        <span className={`issue-severity sev-${issue.severity}`}>{issue.severity.toUpperCase()}</span>\n                        <span className=\"issue-comp\">{issue.component}</span>\n                        <span className=\"issue-file\">{issue.file}:{issue.lines}</span>\n                      </div>\n                      <p className=\"issue-desc\">{issue.description}</p>\n                      <div className=\"issue-recom\">\n                        <strong>Recommendation:</strong> {issue.recommendation}\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 4: Benchmark Comparison */}\n          {activeTab === \'benchmark\' && (\n            <div className=\"agentsam-tab-content benchmark-view\">\n              <h3 className=\"text-base font-semibold text-white mb-2\">\n                Side-by-Side Autonomous Mission Cost & Performance Matrix\n              </h3>\n              <p className=\"text-xs text-gray-400 mb-4\">\n                Comparison of executing a 50k+ token multi-tool autonomous engineering audit across candidate backends:\n              </p>\n\n              <div className=\"benchmark-matrix-table-wrap\">\n                <table className=\"benchmark-matrix-table\">\n                  <thead>\n                    <tr>\n                      <th>Execution Backend</th>\n                      <th>Provisioning</th>\n                      <th>Compute Rate</th>\n                      <th>Model Cost (3.7 Flash)</th>\n                      <th>Est. Total Mission Cost</th>\n                      <th>Sovereignty / Control</th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    <tr className={selectedBackend === \'antigravity\' ? \'row-selected\' : \'\'}>\n                      <td>\n                        <div className=\"font-semibold text-white\">Google Antigravity</div>\n                        <div className=\"text-xs text-gray-400\">Managed Google Cloud sandbox</div>\n                      </td>\n                      <td className=\"text-xs text-emerald-400\">~1.8s (Instant)</td>\n                      <td className=\"text-xs text-emerald-400 font-bold\">$0.00 / hr (Preview)</td>\n                      <td className=\"text-xs text-gray-200\">~$0.21</td>\n                      <td className=\"text-xs text-emerald-300 font-mono font-bold\">~$0.21 total</td>\n                      <td className=\"text-xs text-amber-300\">Managed Sandbox</td>\n                    </tr>\n\n                    <tr className={selectedBackend === \'cloudflare\' ? \'row-selected\' : \'\'}>\n                      <td>\n                        <div className=\"font-semibold text-white\">Cloudflare Containers</div>\n                        <div className=\"text-xs text-gray-400\">Workers Paid basic container</div>\n                      </td>\n                      <td className=\"text-xs text-sky-400\">~3.2s</td>\n                      <td className=\"text-xs text-gray-300 font-mono\">$0.028 / hr (or included)</td>\n                      <td className=\"text-xs text-gray-200\">~$0.21</td>\n                      <td className=\"text-xs text-sky-300 font-mono font-bold\">~$0.2105 total</td>\n                      <td className=\"text-xs text-emerald-400 font-bold\">100% Owned Authority</td>\n                    </tr>\n\n                    <tr className={selectedBackend === \'local_pty\' ? \'row-selected\' : \'\'}>\n                      <td>\n                        <div className=\"font-semibold text-white\">Local Mac / localpty</div>\n                        <div className=\"text-xs text-gray-400\">Direct host execution</div>\n                      </td>\n                      <td className=\"text-xs text-emerald-400\">~0.1s</td>\n                      <td className=\"text-xs text-emerald-400 font-bold\">$0.00</td>\n                      <td className=\"text-xs text-gray-200\">~$0.21</td>\n                      <td className=\"text-xs text-emerald-300 font-mono font-bold\">~$0.21 total</td>\n                      <td className=\"text-xs text-emerald-400 font-bold\">Local Machine</td>\n                    </tr>\n\n                    <tr className={selectedBackend === \'gcp_vm\' ? \'row-selected\' : \'\'}>\n                      <td>\n                        <div className=\"font-semibold text-white\">GCP Compute Engine</div>\n                        <div className=\"text-xs text-gray-400\">e2-standard-2 VM</div>\n                      </td>\n                      <td className=\"text-xs text-amber-400\">~12.5s</td>\n                      <td className=\"text-xs text-gray-300 font-mono\">$0.067 / hr</td>\n                      <td className=\"text-xs text-gray-200\">~$0.21</td>\n                      <td className=\"text-xs text-gray-300 font-mono\">~$0.212 total</td>\n                      <td className=\"text-xs text-sky-400\">Custom Cloud VPC</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n\n              <div className=\"benchmark-insight-box mt-4\">\n                <div className=\"flex items-center gap-2 text-sky-400 font-medium text-sm mb-1\">\n                  <span className=\"material-symbols-outlined text-base\">lightbulb</span>\n                  Strategic Takeaway\n                </div>\n                <p className=\"text-xs text-gray-300 leading-relaxed\">\n                  Compute cost is negligible across all modern container backends (~$0.0005 per run). The dominant driver of autonomous agent economics is <strong>orchestration token efficiency</strong>. Leveraging Google Antigravity as an experimental benchmark lane while keeping Cloudflare Containers as sovereign production infrastructure provides the highest cost predictability and architecture resilience.\n                </p>\n              </div>\n            </div>\n          )}\n        </section>\n\n        {/* RIGHT COLUMN: Live Telemetry & Mission Cockpit */}\n        <aside className=\"agentsam-telemetry-pane\">\n          <div className=\"telemetry-header\">\n            <span className=\"material-symbols-outlined text-sm text-sky-400\">analytics</span>\n            <span className=\"font-semibold text-xs text-gray-200 tracking-wider\">LIVE TELEMETRY COCKPIT</span>\n          </div>\n\n          {/* Realtime Numbers */}\n          <div className=\"telemetry-metrics-grid\">\n            <div className=\"metric-box\">\n              <span className=\"metric-lbl\">TOTAL TOKENS</span>\n              <span className=\"metric-val text-sky-400 font-mono\">\n                {telemetry.totalTokens.toLocaleString()}\n              </span>\n              <div className=\"metric-sub-bar\">\n                <span className=\"text-blue-300\">In: {telemetry.input.toLocaleString()}</span>\n                <span className=\"text-emerald-300\">Out: {telemetry.output.toLocaleString()}</span>\n                <span className=\"text-purple-300\">Think: {telemetry.thinking.toLocaleString()}</span>\n              </div>\n            </div>\n\n            <div className=\"metric-box\">\n              <span className=\"metric-lbl\">ESTIMATED RUN COST</span>\n              <span className=\"metric-val text-emerald-400 font-mono\">\n                ${telemetry.totalCost.toFixed(4)}\n              </span>\n              <div className=\"metric-sub-bar\">\n                <span>Model: ${telemetry.modelCost.toFixed(4)}</span>\n                <span>Compute: ${telemetry.computeCost.toFixed(4)}</span>\n              </div>\n            </div>\n\n            <div className=\"metric-box\">\n              <span className=\"metric-lbl\">WALL CLOCK DURATION</span>\n              <span className=\"metric-val text-gray-200 font-mono\">\n                {(telemetry.durationMs / 1000).toFixed(2)}s\n              </span>\n              <div className=\"metric-sub-bar\">\n                <span>Steps: {visibleSteps.length}/{allSteps.length}</span>\n              </div>\n            </div>\n\n            <div className=\"metric-box\">\n              <span className=\"metric-lbl\">TOOL EXECUTIONS</span>\n              <span className=\"metric-val text-indigo-300 font-mono\">\n                {telemetry.toolCallsCount + telemetry.terminalCallsCount}\n              </span>\n              <div className=\"metric-sub-bar\">\n                <span>Terminal: {telemetry.terminalCallsCount}</span>\n                <span>AST/Diff: {telemetry.toolCallsCount}</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Pricing Model Reference */}\n          <div className=\"pricing-ref-card mt-4\">\n            <div className=\"pricing-ref-title\">Gemini 3.7 Flash Pricing Reference</div>\n            <div className=\"pricing-row\">\n              <span>Input Tokens:</span>\n              <span className=\"font-mono text-gray-200\">$0.75 / 1M</span>\n            </div>\n            <div className=\"pricing-row\">\n              <span>Output & Thinking:</span>\n              <span className=\"font-mono text-gray-200\">$3.75 / 1M</span>\n            </div>\n            <div className=\"pricing-row highlight\">\n              <span>Antigravity Compute:</span>\n              <span className=\"font-mono text-emerald-400 font-bold\">$0.00 (Preview)</span>\n            </div>\n          </div>\n\n          {/* Quick Actions */}\n          <div className=\"quick-actions-box mt-4\">\n            <div className=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2\">Artifact Shortcuts</div>\n            <button\n              onClick={() => setActiveTab(\'artifacts\')}\n              className=\"quick-action-btn\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">schema</span>\n              <span>View Architecture SVG</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'network\')}\n              className=\"quick-action-btn\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">security</span>\n              <span>Inspect Network Egress Log</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'benchmark\')}\n              className=\"quick-action-btn\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">compare_arrows</span>\n              <span>Cloudflare vs Antigravity Matrix</span>\n            </button>\n          </div>\n        </aside>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
        lines {
