        }
        lines {
          text: "export const DEFAULT_APP_SETTINGS: AppSettings = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  themeId: \'midnight-titanium\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
