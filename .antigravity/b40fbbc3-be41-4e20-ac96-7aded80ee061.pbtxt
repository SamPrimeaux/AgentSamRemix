    instruction: "Add CSS custom variables, app shell topbar, patterns, and dynamic theme styling in index.css"
    replacement_infos {
      original_chunk {
        target_content: "/* ==========================================\n   OUTER FRAME\n   ========================================== */\n\n.outer-frame {\n  width: 100vw;\n  height: 100vh;\n  background: #000;\n  display: flex;\n  flex-direction: column;\n  padding: 20px 24px 12px;\n  box-sizing: border-box;\n  font-family: \'Google Sans Flex\', \'Google Sans\', sans-serif;\n  overflow: hidden;\n}\n\n/* CSS-only zoom fallback (JS overrides with smooth linear scaling) */\n@media (min-height: 1081px) {\n  .outer-frame {\n    zoom: 1.25;\n    width: calc(100vw / 1.25);\n    height: calc(100vh / 1.25);\n    --effective-vh: calc(100vh / 1.25);\n  }\n}\n\n@media (min-height: 1300px) {\n  .outer-frame {\n    zoom: 1.5;\n    width: calc(100vw / 1.5);\n    height: calc(100vh / 1.5);\n    --effective-vh: calc(100vh / 1.5);\n  }\n}\n\n.outer-header {\n  flex-shrink: 0;\n  margin-bottom: 2px;\n}\n\n.outer-title {\n  font-size: 60px;\n  font-weight: 500;\n  color: #ffffff;\n  margin: 0;\n  letter-spacing: -0.5px;\n}\n\n.outer-caption-row {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 20px;\n  margin-bottom: 16px;\n}\n\n.outer-caption {\n  font-size: 20px;\n  color: #c4c7cc;\n  margin: 0;\n}\n\n.main-container {\n  flex: 1;\n  width: 100%;\n  max-height: calc(var(--effective-vh, 100vh) - 100px);\n  max-width: calc((var(--effective-vh, 100vh) - 100px) * 16 / 10);\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n}\n\n.browser-container {\n  flex: 1;\n  width: 100%;\n  border-radius: 16px;\n  overflow: hidden;\n  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);\n  border: 1px solid #444;\n  min-height: 0;\n}\n\n/* Toggle Switch (used in dropdown menu) */\n.toggle-track {\n  width: 34px;\n  height: 18px;\n  background: #3c4043;"
        replacement_content: "/* AgentSamRemix Browser & AntiGravity OS \342\200\224 Theme Engine */\n\n:root {\n  --app-bg: #000000;\n  --app-canvas-bg: #0c0d10;\n  --app-surface-1: #181a20;\n  --app-surface-2: #22252c;\n  --app-surface-3: #2e323b;\n  --app-border: #2d313b;\n  --app-border-hover: #434957;\n  --app-border-focus: #8ab4f8;\n  --app-text-primary: #ffffff;\n  --app-text-secondary: #c4c7cc;\n  --app-text-muted: #80868b;\n  --app-accent: #8ab4f8;\n  --app-accent-rgb: 138, 180, 248;\n  --app-accent-glow: rgba(138, 180, 248, 0.35);\n  --app-accent-hover: #1a73e8;\n  --app-success: #81c995;\n  --app-warning: #fbbc04;\n  --app-error: #f28b82;\n  --app-tab-bg: #1e2025;\n  --app-tab-active: #2c2f37;\n  --app-omnibar-bg: #16181e;\n  --app-omnibar-focus: #22252c;\n  --app-shadow: 0 8px 32px rgba(0, 0, 0, 0.65);\n  --app-radius-base: 10px;\n  --app-radius-card: 16px;\n  --app-radius-pill: 24px;\n  --app-density-scale: 1;\n  --app-font-family: \'Google Sans Flex\', \'Google Sans\', -apple-system, BlinkMacSystemFont, sans-serif;\n  --app-glow-opacity: 1;\n  --app-glass-filter: blur(16px);\n}\n\n/* ==========================================\n   OUTER FRAME & APP SHELL\n   ========================================== */\n\n.outer-frame {\n  width: 100vw;\n  height: 100vh;\n  background: var(--app-bg, #000);\n  display: flex;\n  flex-direction: column;\n  padding: 16px 20px 10px;\n  box-sizing: border-box;\n  font-family: var(--app-font-family);\n  overflow: hidden;\n  position: relative;\n  transition: background-color 0.25s ease, color 0.25s ease;\n}\n\n/* Canvas Backdrop Textures */\n.canvas-texture-layer {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  pointer-events: none;\n  z-index: 0;\n  opacity: 0.6;\n}\n\n.canvas-texture-layer.pattern-dots {\n  background-image: radial-gradient(var(--app-border, #333) 1px, transparent 1px);\n  background-size: 24px 24px;\n}\n\n.canvas-texture-layer.pattern-grid {\n  background-image: linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),\n                    linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);\n  background-size: 32px 32px;\n}\n\n.canvas-texture-layer.pattern-vignette {\n  background: radial-gradient(circle at center, transparent 30%, rgba(0, 0, 0, 0.6) 100%);\n}\n\n.canvas-texture-layer.pattern-minimal {\n  display: none;\n}\n\n/* CSS-only zoom fallback (JS overrides with smooth linear scaling) */\n@media (min-height: 1081px) {\n  .outer-frame {\n    zoom: 1.25;\n    width: calc(100vw / 1.25);\n    height: calc(100vh / 1.25);\n    --effective-vh: calc(100vh / 1.25);\n  }\n}\n\n@media (min-height: 1300px) {\n  .outer-frame {\n    zoom: 1.5;\n    width: calc(100vw / 1.5);\n    height: calc(100vh / 1.5);\n    --effective-vh: calc(100vh / 1.5);\n  }\n}\n\n.outer-frame.maximized-view .main-container {\n  max-width: 100%;\n  max-height: calc(var(--effective-vh, 100vh) - 70px);\n}\n\n.outer-header {\n  flex-shrink: 0;\n  margin-bottom: 4px;\n  position: relative;\n  z-index: 2;\n}\n\n/* App Shell Topbar */\n.app-shell-topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  flex-wrap: wrap;\n  padding-bottom: 8px;\n}\n\n.app-shell-brand-group {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n/* Native Window Controls */\n.app-window-controls {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  background: var(--app-surface-1, #181a20);\n  border: 1px solid var(--app-border, #2d313b);\n  padding: 6px 9px;\n  border-radius: 20px;\n}\n\n.win-btn {\n  width: 11px;\n  height: 11px;\n  border-radius: 50%;\n  border: none;\n  cursor: pointer;\n  padding: 0;\n  transition: transform 0.15s ease, filter 0.15s ease;\n}\n\n.win-btn:hover {\n  transform: scale(1.15);\n  filter: brightness(1.2);\n}\n\n.win-close { background: #ff5f56; }\n.win-minimize { background: #ffbd2e; }\n.win-maximize { background: #27c93f; }\n\n.app-title-cluster {\n  display: flex;\n  align-items: baseline;\n  gap: 12px;\n}\n\n.outer-title {\n  font-size: 38px;\n  font-weight: 600;\n  color: var(--app-text-primary, #ffffff);\n  margin: 0;\n  letter-spacing: -0.5px;\n  line-height: 1.1;\n}\n\n.app-shell-status-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  background: var(--app-surface-2, #22252c);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-pill, 24px);\n  padding: 3px 9px;\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--app-text-secondary, #c4c7cc);\n}\n\n.app-pulse-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--app-success, #81c995);\n  box-shadow: 0 0 8px var(--app-success, #81c995);\n  animation: pulse 2s infinite ease-in-out;\n}\n\n/* App Shell Actions Cluster */\n.app-shell-actions-cluster {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n/* Quick Theme Button */\n.theme-quick-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  background: var(--app-surface-1, #181a20);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-pill, 24px);\n  padding: 6px 12px;\n  color: var(--app-text-secondary, #c4c7cc);\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n}\n\n.theme-quick-btn:hover {\n  background: var(--app-surface-2, #22252c);\n  border-color: var(--app-border-hover, #434957);\n  color: var(--app-text-primary, #fff);\n}\n\n.theme-swatch-dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  box-shadow: 0 0 6px currentColor;\n}\n\n/* Settings Gear Trigger Button */\n.app-settings-trigger-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  background: var(--app-surface-1, #181a20);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-pill, 24px);\n  padding: 6px 14px;\n  color: var(--app-text-primary, #ffffff);\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\n}\n\n.app-settings-trigger-btn:hover {\n  background: var(--app-surface-2, #22252c);\n  border-color: var(--app-accent, #8ab4f8);\n  color: var(--app-accent, #8ab4f8);\n  box-shadow: 0 0 12px var(--app-accent-glow, rgba(138, 180, 248, 0.35));\n}\n\n.outer-caption-row {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 20px;\n  margin-bottom: 12px;\n}\n\n.outer-caption {\n  font-size: 15px;\n  color: var(--app-text-secondary, #c4c7cc);\n  margin: 0;\n}\n\n.main-container {\n  flex: 1;\n  width: 100%;\n  max-height: calc(var(--effective-vh, 100vh) - 90px);\n  max-width: calc((var(--effective-vh, 100vh) - 90px) * 16 / 10);\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  position: relative;\n  z-index: 1;\n}\n\n.browser-container {\n  flex: 1;\n  width: 100%;\n  border-radius: var(--app-radius-card, 16px);\n  overflow: hidden;\n  box-shadow: var(--app-shadow, 0 4px 24px rgba(0, 0, 0, 0.6));\n  border: 1px solid var(--app-border, #444);\n  min-height: 0;\n  background: var(--app-canvas-bg, #0c0d10);\n  transition: border-color 0.25s ease, box-shadow 0.25s ease;\n}\n\n/* Toggle Switch (used in dropdown menu) */\n.toggle-track {\n  width: 34px;\n  height: 18px;\n  background: var(--app-surface-3, #3c4043);\n  border-radius: 9px;\n  position: relative;\n  transition: background 0.2s ease;\n  cursor: pointer;\n  flex-shrink: 0;\n}"
      }
      num_matches: 1
    }
  }
}
