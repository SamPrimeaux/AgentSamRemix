  file_change {
    absolute_path_uri: "file:///components/OuterFrame.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "interface OuterFrameProps {\n  children: React.ReactNode;\n  tokenCount: TokenCount | null;\n  isLoading: boolean;\n}\n\nexport const OuterFrame: React.FC<OuterFrameProps> = ({\n  children,\n  tokenCount,\n  isLoading\n}) => {\n  // Linear zoom: 1.0 at \342\211\2441080px viewport height, 1.5 at 1440px, etc.\n  const [zoom, setZoom] = useState(1);\n  useEffect(() => {\n    const update = () => {\n      const vh = window.innerHeight;\n      setZoom(Math.max(1, 1 + (vh - 1080) * 0.5 / 360));\n    };\n    update();\n    window.addEventListener(\'resize\', update);\n    return () => window.removeEventListener(\'resize\', update);\n  }, []);\n\n  const isOutputPhase = (tokenCount?.output ?? 0) > 0;\n  const arrowIcon = isOutputPhase ? \'arrow_downward\' : \'arrow_upward\';\n  const phaseClass = isOutputPhase ? \'token-out\' : \'token-in\';\n  const totalTokens = (tokenCount?.input ?? 0) + (tokenCount?.output ?? 0);\n\n  const frameStyle: React.CSSProperties = zoom > 1 ? {\n    zoom,\n    width: `calc(100vw / ${zoom})`,\n    height: `calc(100vh / ${zoom})`,\n    [\'--effective-vh\' as string]: `calc(100vh / ${zoom})`,\n  } : {};\n\n  return (\n    <div className=\"outer-frame\" style={frameStyle}>\n      <div className=\"main-container\">\n        {/* Header \342\200\224 same width as browser */}\n        <div className=\"outer-header\">\n          <h1 className=\"outer-title\">AgentSamRemix Browser</h1>\n          <div className=\"outer-caption-row\">\n            <p className=\"outer-caption\">Imagine any website, generated in real-time by AgentSam</p>\n            {tokenCount && (\n              <span className=\"token-display\" aria-live=\"polite\" aria-atomic=\"true\">\n                <span className={phaseClass}>\n                  <span className=\"material-symbols-outlined token-icon\" aria-hidden=\"true\">\n                    {isLoading ? arrowIcon : \'check\'}\n                  </span>\n                  <AnimatedNumber value={totalTokens} prefix=\"~\" prefixVisible={!!tokenCount.isEstimate} animate={isLoading} />\n                </span>\n                {\' \'}\n                <span className=\"token-label\">tokens in</span>\n                {\' \'}\n                <span className=\"token-label\"><ElapsedTimer isActive={isLoading} /></span>\n              </span>\n            )}\n          </div>\n        </div>\n\n        {/* Browser Container */}\n        <div className=\"browser-container\">\n          {children}\n        </div>\n      </div>\n      <div className=\"footer\">Created by <a href=\"https://x.com/cobley_ben\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"footer-link\">Ben Cobley</a></div>\n    </div>\n  );\n};"
      replacement_content: "interface OuterFrameProps {\n  children: React.ReactNode;\n  tokenCount: TokenCount | null;\n  isLoading: boolean;\n  appMode?: \'browser\' | \'antigravity\';\n  onAppModeChange?: (mode: \'browser\' | \'antigravity\') => void;\n}\n\nexport const OuterFrame: React.FC<OuterFrameProps> = ({\n  children,\n  tokenCount,\n  isLoading,\n  appMode = \'browser\',\n  onAppModeChange,\n}) => {\n  // Linear zoom: 1.0 at \342\211\2441080px viewport height, 1.5 at 1440px, etc.\n  const [zoom, setZoom] = useState(1);\n  useEffect(() => {\n    const update = () => {\n      const vh = window.innerHeight;\n      setZoom(Math.max(1, 1 + (vh - 1080) * 0.5 / 360));\n    };\n    update();\n    window.addEventListener(\'resize\', update);\n    return () => window.removeEventListener(\'resize\', update);\n  }, []);\n\n  const isOutputPhase = (tokenCount?.output ?? 0) > 0;\n  const arrowIcon = isOutputPhase ? \'arrow_downward\' : \'arrow_upward\';\n  const phaseClass = isOutputPhase ? \'token-out\' : \'token-in\';\n  const totalTokens = (tokenCount?.input ?? 0) + (tokenCount?.output ?? 0);\n\n  const frameStyle: React.CSSProperties = zoom > 1 ? {\n    zoom,\n    width: `calc(100vw / ${zoom})`,\n    height: `calc(100vh / ${zoom})`,\n    [\'--effective-vh\' as string]: `calc(100vh / ${zoom})`,\n  } : {};\n\n  return (\n    <div className=\"outer-frame\" style={frameStyle}>\n      <div className=\"main-container\">\n        {/* Header \342\200\224 same width as browser */}\n        <div className=\"outer-header\">\n          <div className=\"flex items-center justify-between flex-wrap gap-2\">\n            <h1 className=\"outer-title\">AgentSamRemix Browser</h1>\n            {onAppModeChange && (\n              <div className=\"view-toggle-buttons\">\n                <button\n                  type=\"button\"\n                  onClick={() => onAppModeChange(\'browser\')}\n                  className={`view-mode-btn ${appMode === \'browser\' ? \'active\' : \'\'}`}\n                >\n                  <span className=\"material-symbols-outlined\" style={{ fontSize: \'15px\' }}>language</span>\n                  <span>Browser Mode</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => onAppModeChange(\'antigravity\')}\n                  className={`view-mode-btn ${appMode === \'antigravity\' ? \'active\' : \'\'}`}\n                >\n                  <span className=\"material-symbols-outlined\" style={{ fontSize: \'15px\' }}>terminal</span>\n                  <span>AntiGravity Lane</span>\n                  <span className=\"view-mode-badge\">NEW</span>\n                </button>\n              </div>\n            )}\n          </div>\n          <div className=\"outer-caption-row\">\n            <p className=\"outer-caption\">\n              {appMode === \'browser\'\n                ? \'Imagine any website, generated in real-time by AgentSam\'\n                : \'Autonomous multi-backend execution sandbox & telemetry benchmarker (Cloudflare vs Google Antigravity)\'}\n            </p>\n            {tokenCount && appMode === \'browser\' && (\n              <span className=\"token-display\" aria-live=\"polite\" aria-atomic=\"true\">\n                <span className={phaseClass}>\n                  <span className=\"material-symbols-outlined token-icon\" aria-hidden=\"true\">\n                    {isLoading ? arrowIcon : \'check\'}\n                  </span>\n                  <AnimatedNumber value={totalTokens} prefix=\"~\" prefixVisible={!!tokenCount.isEstimate} animate={isLoading} />\n                </span>\n                {\' \'}\n                <span className=\"token-label\">tokens in</span>\n                {\' \'}\n                <span className=\"token-label\"><ElapsedTimer isActive={isLoading} /></span>\n              </span>\n            )}\n          </div>\n        </div>\n\n        {/* Browser Container */}\n        <div className=\"browser-container\">\n          {children}\n        </div>\n      </div>\n      <div className=\"footer\">AgentSamRemix \342\200\242 Cloudflare Containers & Google Antigravity Benchmarking Architecture</div>\n    </div>\n  );\n};"
    }
    diff {
      end_line: 133
      unified_diff {
        lines {
          text: "import React, { useRef, useCallback, useState, useEffect } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import { TokenCount } from \'../types\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
