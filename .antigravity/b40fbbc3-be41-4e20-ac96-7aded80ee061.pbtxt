      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { RepositoryIntelligenceReport } from \'../../sdk/types\';\nimport { RepositoryIntelligence } from \'../../sdk/repository\';\n\ninterface RepoIntelligenceViewProps {\n  repoName: string;\n  onStartMissionForSignal?: (signalTitle: string, description: string) => void;\n}\n\nexport const RepoIntelligenceView: React.FC<RepoIntelligenceViewProps> = ({\n  repoName,\n  onStartMissionForSignal,\n}) => {\n  const [report, setReport] = useState<RepositoryIntelligenceReport | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [activeTab, setActiveTab] = useState<\'overview\' | \'duplicates\' | \'godfiles\' | \'churn\'>(\'overview\');\n\n  const inspector = new RepositoryIntelligence();\n\n  useEffect(() => {\n    let mounted = true;\n    setLoading(true);\n    inspector.inspect(repoName).then(data => {\n      if (mounted) {\n        setReport(data);\n        setLoading(false);\n      }\n    });\n    return () => { mounted = false; };\n  }, [repoName]);\n\n  if (loading || !report) {\n    return (\n      <div className=\"flex-1 flex flex-col items-center justify-center p-12 text-zinc-400\">\n        <span className=\"material-symbols-outlined text-3xl animate-spin text-sky-400 mb-3\">\n          progress_activity\n        </span>\n        <p className=\"text-sm font-medium\">Scanning AST & Git churn topology for {repoName}...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex-1 flex flex-col overflow-y-auto p-6 space-y-6 text-zinc-200\">\n      {/* Top Banner & Quick Metrics */}\n      <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4 p-5 bg-zinc-900/80 border border-zinc-800 rounded-xl backdrop-blur\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"material-symbols-outlined text-sky-400 text-xl\">insights</span>\n            <h2 className=\"text-lg font-bold text-white tracking-tight\">{report.repoName}</h2>\n            <span className=\"text-xs px-2 py-0.5 rounded bg-zinc-800 border border-zinc-700 font-mono text-zinc-300\">\n              {report.branch} @ {report.commitHash}\n            </span>\n          </div>\n          <p className=\"text-xs text-zinc-400\">\n            Automated intelligence report generated by <code className=\"text-sky-300 font-mono\">@inneranimalmedia/agentsam-sdk/repository</code>\n          </p>\n        </div>\n\n        {/* Health Score Pill */}\n        <div className=\"flex items-center gap-6\">\n          <div className=\"text-right\">\n            <div className=\"text-2xl font-bold text-emerald-400 font-mono\">{report.summary.healthScore}/100</div>\n            <div className=\"text-[11px] text-zinc-400\">Architecture Health Score</div>\n          </div>\n          <div className=\"h-10 w-px bg-zinc-800\" />\n          <div className=\"text-right\">\n            <div className=\"text-2xl font-bold text-sky-400 font-mono\">{report.summary.totalLoc.toLocaleString()}</div>\n            <div className=\"text-[11px] text-zinc-400\">Total Lines of Code</div>\n          </div>\n        </div>\n      </div>\n\n      {/* Sub-Navigation Tabs */}\n      <div className=\"flex border-b border-zinc-800 gap-6\">\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'overview\')}\n          className={`pb-3 text-xs font-semibold flex items-center gap-2 border-b-2 transition-all ${\n            activeTab === \'overview\'\n              ? \'border-sky-400 text-sky-400\'\n              : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-sm\">dashboard</span>\n          <span>Overview & Topology</span>\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'duplicates\')}\n          className={`pb-3 text-xs font-semibold flex items-center gap-2 border-b-2 transition-all ${\n            activeTab === \'duplicates\'\n              ? \'border-sky-400 text-sky-400\'\n              : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-sm text-amber-400\">compare_arrows</span>\n          <span>Duplicate Authorities ({report.duplicateAuthoritySignals.length})</span>\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'godfiles\')}\n          className={`pb-3 text-xs font-semibold flex items-center gap-2 border-b-2 transition-all ${\n            activeTab === \'godfiles\'\n              ? \'border-sky-400 text-sky-400\'\n              : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-sm text-rose-400\">warning</span>\n          <span>God File Candidates ({report.godFileCandidates.length})</span>\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'churn\')}\n          className={`pb-3 text-xs font-semibold flex items-center gap-2 border-b-2 transition-all ${\n            activeTab === \'churn\'\n              ? \'border-sky-400 text-sky-400\'\n              : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-sm text-purple-400\">trending_up</span>\n          <span>Git Churn Hotspots</span>\n        </button>\n      </div>\n\n      {/* TAB 1: Overview */}\n      {activeTab === \'overview\' && (\n        <div className=\"space-y-6\">\n          {/* Summary Grid */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4\">\n            <div className=\"p-4 bg-zinc-900/60 border border-zinc-800 rounded-xl\">\n              <span className=\"text-xs text-zinc-500 font-medium\">Total Files</span>\n              <div className=\"text-xl font-bold text-zinc-100 mt-1\">{report.summary.totalFiles}</div>\n            </div>\n            <div className=\"p-4 bg-zinc-900/60 border border-zinc-800 rounded-xl\">\n              <span className=\"text-xs text-zinc-500 font-medium\">Test Coverage</span>\n              <div className=\"text-xl font-bold text-emerald-400 mt-1\">\n                {Math.round(report.summary.testCoverageRatio * 100)}%\n              </div>\n            </div>\n            <div className=\"p-4 bg-zinc-900/60 border border-zinc-800 rounded-xl\">\n              <span className=\"text-xs text-zinc-500 font-medium\">Languages</span>\n              <div className=\"text-xl font-bold text-sky-400 mt-1\">{report.summary.totalLanguages}</div>\n            </div>\n            <div className=\"p-4 bg-zinc-900/60 border border-zinc-800 rounded-xl\">\n              <span className=\"text-xs text-zinc-500 font-medium\">Direct Dependencies</span>\n              <div className=\"text-xl font-bold text-purple-400 mt-1\">{report.dependencyPressure.directDependencies}</div>\n            </div>\n          </div>\n\n          {/* Language Breakdown */}\n          <div className=\"p-5 bg-zinc-900/60 border border-zinc-800 rounded-xl\">\n            <h3 className=\"text-xs font-bold text-zinc-400 uppercase tracking-wider mb-4\">Language Distribution</h3>\n            <div className=\"space-y-3\">\n              {Object.entries(report.languageDistribution).map(([lang, stats]) => (\n                <div key={lang} className=\"space-y-1\">\n                  <div className=\"flex justify-between text-xs font-mono\">\n                    <span className=\"text-zinc-200\">{lang}</span>\n                    <span className=\"text-zinc-400\">{stats.percentage}% ({stats.loc.toLocaleString()} LOC)</span>\n                  </div>\n                  <div className=\"h-1.5 w-full bg-zinc-800 rounded-full overflow-hidden\">\n                    <div\n                      className=\"h-full bg-sky-500 rounded-full\"\n                      style={{ width: `${stats.percentage}%` }}\n                    />\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Monorepo Topology */}\n          <div className=\"p-5 bg-zinc-900/60 border border-zinc-800 rounded-xl\">\n            <h3 className=\"text-xs font-bold text-zinc-400 uppercase tracking-wider mb-4\">Workspace Packages & Subtrees</h3>\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n              {report.workspaceTopology.packages.map(pkg => (\n                <div key={pkg.name} className=\"p-3 bg-zinc-950/80 border border-zinc-800 rounded-lg flex items-center justify-between\">\n                  <div>\n                    <span className=\"text-xs font-mono font-bold text-sky-300\">{pkg.name}</span>\n                    <div className=\"text-[11px] text-zinc-500 font-mono mt-0.5\">{pkg.path}</div>\n                  </div>\n                  <span className=\"text-xs font-mono text-zinc-400\">{pkg.loc.toLocaleString()} LOC</span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 2: Duplicate Authorities */}\n      {activeTab === \'duplicates\' && (\n        <div className=\"space-y-4\">\n          <div className=\"p-4 bg-amber-500/10 border border-amber-500/30 rounded-xl text-xs text-amber-300 flex items-start gap-3\">\n            <span className=\"material-symbols-outlined text-amber-400 text-lg\">info</span>\n            <div>\n              <strong className=\"block font-semibold mb-0.5\">Architectural Refactoring Target</strong>\n              Agent Sam identified duplicated authorities between legacy modules and new SDK implementations. Consolidating these eliminates auth discrepancies and reduces maintenance debt.\n            </div>\n          </div>\n\n          {report.duplicateAuthoritySignals.map((signal, idx) => (\n            <div key={idx} className=\"p-5 bg-zinc-900/80 border border-zinc-800 rounded-xl space-y-3\">\n              <div className=\"flex items-start justify-between gap-4\">\n                <div>\n                  <h4 className=\"text-sm font-bold text-white flex items-center gap-2\">\n                    <span className=\"material-symbols-outlined text-amber-400 text-base\">rule</span>\n                    <span>{signal.domain}</span>\n                  </h4>\n                  <p className=\"text-xs text-zinc-400 mt-1\">{signal.description}</p>\n                </div>\n                {onStartMissionForSignal && (\n                  <button\n                    type=\"button\"\n                    onClick={() => onStartMissionForSignal(\n                      `Eliminate duplicate authority in ${signal.domain}`,\n                      signal.recommendation\n                    )}\n                    className=\"px-3 py-1.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-medium transition-colors flex items-center gap-1.5 shrink-0\"\n                  >\n                    <span className=\"material-symbols-outlined text-sm\">play_arrow</span>\n                    <span>Begin Refactor Mission</span>\n                  </button>\n                )}\n              </div>\n\n              <div className=\"p-3 bg-zinc-950 rounded-lg border border-zinc-800\">\n                <span className=\"text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1.5\">Files Involved</span>\n                <div className=\"flex flex-wrap gap-2\">\n                  {signal.filesInvolved.map(file => (\n                    <span key={file} className=\"px-2 py-1 bg-zinc-900 border border-zinc-800 rounded font-mono text-[11px] text-zinc-300\">\n                      {file}\n                    </span>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"text-xs text-emerald-400 flex items-center gap-2 bg-emerald-500/5 p-2.5 rounded-lg border border-emerald-500/20\">\n                <span className=\"material-symbols-outlined text-sm\">lightbulb</span>\n                <span><strong>Recommendation:</strong> {signal.recommendation}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* TAB 3: God Files */}\n      {activeTab === \'godfiles\' && (\n        <div className=\"space-y-4\">\n          {report.godFileCandidates.length === 0 ? (\n            <div className=\"p-8 text-center bg-zinc-900/40 border border-zinc-800 rounded-xl text-zinc-400 text-xs\">\n              \342\234\223 No critical God Files detected. Modularity is within healthy bounds.\n            </div>\n          ) : (\n            report.godFileCandidates.map((god, idx) => (\n              <div key={idx} className=\"p-5 bg-zinc-900/80 border border-zinc-800 rounded-xl space-y-3\">\n                <div className=\"flex justify-between items-start\">\n                  <div>\n                    <h4 className=\"text-sm font-mono font-bold text-rose-400\">{god.path}</h4>\n                    <p className=\"text-xs text-zinc-400 mt-1\">{god.reason}</p>\n                  </div>\n                  <div className=\"text-right shrink-0\">\n                    <span className=\"text-sm font-bold text-zinc-200 font-mono\">{god.loc} LOC</span>\n                    <span className=\"text-[11px] text-zinc-500 block\">{god.incomingReferences} incoming refs</span>\n                  </div>\n                </div>\n\n                <div className=\"p-3 bg-zinc-950 rounded-lg border border-zinc-800\">\n                  <span className=\"text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1\">Distinct Mixed Responsibilities</span>\n                  <div className=\"flex flex-wrap gap-1.5\">\n                    {god.distinctResponsibilities.map((resp, i) => (\n                      <span key={i} className=\"px-2 py-0.5 bg-rose-500/10 text-rose-300 border border-rose-500/20 rounded text-[11px]\">\n                        {resp}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n      )}\n\n      {/* TAB 4: Git Churn */}\n      {activeTab === \'churn\' && (\n        <div className=\"space-y-3\">\n          <div className=\"p-4 bg-zinc-900/60 border border-zinc-800 rounded-xl mb-4\">\n            <h4 className=\"text-xs font-bold text-zinc-300 uppercase tracking-wider\">Top Hotspots by Git Churn (Past 30 Days)</h4>\n          </div>\n          {report.hotFilesByGitChurn.map(file => (\n            <div key={file.path} className=\"p-3.5 bg-zinc-900/60 border border-zinc-800 rounded-xl flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-8 h-8 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-mono text-xs font-bold\">\n                  {file.churnScore}\n                </div>\n                <div>\n                  <span className=\"text-xs font-mono text-zinc-200 font-semibold\">{file.path}</span>\n                  <span className=\"text-[11px] text-zinc-500 block\">{file.commitsInLast30Days} commits recently</span>\n                </div>\n              </div>\n              <span className=\"text-[11px] font-medium text-purple-300 bg-purple-500/10 px-2.5 py-1 rounded-full border border-purple-500/20\">\n                High Churn\n              </span>\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
