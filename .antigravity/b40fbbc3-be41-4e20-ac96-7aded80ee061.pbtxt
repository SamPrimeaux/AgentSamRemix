        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "const SETTINGS_STORAGE_KEY = \'agentsam_app_settings_v3\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function loadStoredSettings(): AppSettings {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  try {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const raw = localStorage.getItem(SETTINGS_STORAGE_KEY);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (!raw) return DEFAULT_APP_SETTINGS;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const parsed = JSON.parse(raw);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return { ...DEFAULT_APP_SETTINGS, ...parsed };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  } catch (err) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    console.warn(\'Failed to load stored settings, using defaults:\', err);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
