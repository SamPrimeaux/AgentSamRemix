  file_change {
    absolute_path_uri: "file:///index.css"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: ".quick-action-btn:hover {\n  background: #252836;\n  color: #fff;\n  border-color: #3b4255;\n}"
      replacement_content: ".quick-action-btn:hover {\n  background: #252836;\n  color: #fff;\n  border-color: #3b4255;\n}\n\n/* ==========================================\n   APP FOOTER & THEME LINK\n   ========================================== */\n.footer {\n  margin-top: 6px;\n  flex-shrink: 0;\n  text-align: center;\n  font-size: 11px;\n  color: var(--app-text-muted, #80868b);\n  position: relative;\n  z-index: 2;\n}\n\n.footer-content {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: var(--app-surface-1, #181a20);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-pill, 24px);\n  padding: 4px 14px;\n}\n\n.footer-sep {\n  opacity: 0.4;\n}\n\n.footer-theme-link {\n  background: transparent;\n  border: none;\n  color: var(--app-accent, #8ab4f8);\n  font-size: 11px;\n  font-weight: 500;\n  cursor: pointer;\n  padding: 0;\n  font-family: inherit;\n  transition: opacity 0.15s ease;\n}\n\n.footer-theme-link:hover {\n  opacity: 0.8;\n  text-decoration: underline;\n}\n\n/* ==========================================\n   SETTINGS MODAL & THEME STUDIO\n   ========================================== */\n.settings-modal-backdrop {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.75);\n  backdrop-filter: blur(8px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 9999;\n  padding: 20px;\n  animation: fadeIn 0.2s ease-out;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n.settings-modal-container {\n  width: 100%;\n  max-width: 820px;\n  max-height: 88vh;\n  background: var(--app-surface-1, #181a20);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-card, 16px);\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 40px var(--app-accent-glow, rgba(138, 180, 248, 0.2));\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  animation: slideUpModal 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n  font-family: var(--app-font-family);\n  color: var(--app-text-primary, #ffffff);\n}\n\n@keyframes slideUpModal {\n  from { transform: translateY(20px) scale(0.98); opacity: 0; }\n  to { transform: translateY(0) scale(1); opacity: 1; }\n}\n\n.settings-modal-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 16px 24px;\n  border-bottom: 1px solid var(--app-border, #2d313b);\n  background: var(--app-surface-2, #22252c);\n}\n\n.settings-header-title-group {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.settings-header-icon-box {\n  width: 36px;\n  height: 36px;\n  border-radius: var(--app-radius-base, 10px);\n  background: var(--app-surface-1, #181a20);\n  border: 1px solid var(--app-border, #2d313b);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.settings-modal-title {\n  font-size: 17px;\n  font-weight: 600;\n  margin: 0;\n  color: var(--app-text-primary, #ffffff);\n}\n\n.settings-modal-subtitle {\n  font-size: 12px;\n  color: var(--app-text-secondary, #c4c7cc);\n  margin: 2px 0 0;\n}\n\n.settings-close-btn {\n  background: transparent;\n  border: none;\n  color: var(--app-text-muted, #80868b);\n  cursor: pointer;\n  padding: 6px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.15s ease;\n}\n\n.settings-close-btn:hover {\n  background: var(--app-surface-3, #2e323b);\n  color: var(--app-text-primary, #ffffff);\n}\n\n/* Settings Navigation Tabs */\n.settings-nav-tabs {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  padding: 8px 16px;\n  border-bottom: 1px solid var(--app-border, #2d313b);\n  background: var(--app-canvas-bg, #0c0d10);\n  overflow-x: auto;\n  scrollbar-width: none;\n}\n\n.settings-nav-tabs::-webkit-scrollbar {\n  display: none;\n}\n\n.settings-nav-tab {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 14px;\n  border-radius: var(--app-radius-base, 10px);\n  background: transparent;\n  border: 1px solid transparent;\n  color: var(--app-text-secondary, #c4c7cc);\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  white-space: nowrap;\n  font-family: inherit;\n}\n\n.settings-nav-tab:hover {\n  background: var(--app-surface-2, #22252c);\n  color: var(--app-text-primary, #ffffff);\n}\n\n.settings-nav-tab.active {\n  background: var(--app-surface-2, #22252c);\n  border-color: var(--app-border, #2d313b);\n  color: var(--app-accent, #8ab4f8);\n  font-weight: 600;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\n}\n\n/* Settings Body & Sections */\n.settings-modal-body {\n  flex: 1;\n  overflow-y: auto;\n  padding: 20px 24px;\n  background: var(--app-canvas-bg, #0c0d10);\n}\n\n.settings-section {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.settings-filter-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 8px;\n  flex-wrap: wrap;\n}\n\n.settings-filter-label {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--app-text-muted, #80868b);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.settings-filter-chips {\n  display: flex;\n  gap: 6px;\n}\n\n.filter-chip {\n  padding: 4px 10px;\n  background: var(--app-surface-2, #22252c);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-pill, 24px);\n  color: var(--app-text-secondary, #c4c7cc);\n  font-size: 11px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n}\n\n.filter-chip:hover {\n  border-color: var(--app-border-hover, #434957);\n}\n\n.filter-chip.active {\n  background: var(--app-accent, #8ab4f8);\n  color: #000000;\n  border-color: var(--app-accent, #8ab4f8);\n  font-weight: 700;\n}\n\n/* Theme Grid */\n.theme-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n  gap: 14px;\n}\n\n.theme-card {\n  background: var(--app-surface-1, #181a20);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-base, 10px);\n  overflow: hidden;\n  cursor: pointer;\n  transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;\n  display: flex;\n  flex-direction: column;\n}\n\n.theme-card:hover {\n  transform: translateY(-2px);\n  border-color: var(--app-border-hover, #434957);\n  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);\n}\n\n.theme-card.selected {\n  border-color: var(--app-accent, #8ab4f8);\n  box-shadow: 0 0 16px var(--app-accent-glow, rgba(138, 180, 248, 0.35));\n}\n\n.theme-card-preview {\n  height: 80px;\n  padding: 10px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  position: relative;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.theme-card-preview-bar {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 8px;\n  border-radius: 6px;\n  border: 1px solid;\n}\n\n.theme-preview-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n}\n\n.theme-preview-line {\n  flex: 1;\n  height: 3px;\n  border-radius: 2px;\n  opacity: 0.6;\n}\n\n.theme-card-preview-pills {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.theme-preview-badge {\n  font-size: 9px;\n  font-weight: 700;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.theme-preview-color-blob {\n  width: 14px;\n  height: 14px;\n  border-radius: 50%;\n  box-shadow: 0 0 8px currentColor;\n}\n\n.theme-card-info {\n  padding: 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.theme-card-header-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.theme-card-name {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--app-text-primary, #ffffff);\n}\n\n.theme-active-tag {\n  font-size: 9px;\n  font-weight: 700;\n  background: var(--app-accent, #8ab4f8);\n  color: #000000;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.theme-card-desc {\n  font-size: 11px;\n  color: var(--app-text-secondary, #c4c7cc);\n  margin: 0;\n  line-height: 1.4;\n}\n\n/* Accent Swatch List */\n.accent-swatch-list {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n  margin-top: 10px;\n}\n\n.accent-swatch-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 10px;\n  background: var(--app-surface-2, #22252c);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-pill, 24px);\n  color: var(--app-text-secondary, #c4c7cc);\n  font-size: 11px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n}\n\n.accent-swatch-btn:hover {\n  border-color: var(--app-border-hover, #434957);\n}\n\n.accent-swatch-btn.active {\n  border-color: var(--app-accent, #8ab4f8);\n  background: var(--app-surface-3, #2e323b);\n  color: var(--app-text-primary, #ffffff);\n  box-shadow: 0 0 10px var(--app-accent-glow, rgba(138, 180, 248, 0.35));\n}\n\n.swatch-circle {\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  box-shadow: 0 0 6px currentColor;\n}\n\n.accent-reset-btn {\n  padding: 6px 12px;\n  background: transparent;\n  border: 1px dashed var(--app-border, #2d313b);\n  border-radius: var(--app-radius-pill, 24px);\n  color: var(--app-text-muted, #80868b);\n  font-size: 11px;\n  cursor: pointer;\n  font-family: inherit;\n  transition: all 0.15s ease;\n}\n\n.accent-reset-btn:hover {\n  color: var(--app-text-primary, #ffffff);\n  border-color: var(--app-text-secondary, #c4c7cc);\n}\n\n/* Settings Sub-Cards & Controls */\n.settings-sub-card {\n  background: var(--app-surface-1, #181a20);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-base, 10px);\n  padding: 16px;\n}\n\n.sub-card-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 4px;\n}\n\n.sub-card-title {\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--app-text-primary, #ffffff);\n}\n\n.sub-card-desc {\n  font-size: 12px;\n  color: var(--app-text-secondary, #c4c7cc);\n  margin: 0 0 12px;\n  line-height: 1.4;\n}\n\n.settings-grid-cols {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n  gap: 14px;\n}\n\n.settings-button-group {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.settings-opt-btn {\n  flex: 1;\n  padding: 8px 12px;\n  background: var(--app-surface-2, #22252c);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-base, 8px);\n  color: var(--app-text-secondary, #c4c7cc);\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n  text-align: center;\n  white-space: nowrap;\n}\n\n.settings-opt-btn:hover {\n  background: var(--app-surface-3, #2e323b);\n}\n\n.settings-opt-btn.active {\n  background: var(--app-surface-3, #2e323b);\n  border-color: var(--app-accent, #8ab4f8);\n  color: var(--app-accent, #8ab4f8);\n  font-weight: 600;\n}\n\n.settings-toggle-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n}\n\n.toggle-label-title {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--app-text-primary, #ffffff);\n}\n\n.toggle-label-desc {\n  font-size: 11px;\n  color: var(--app-text-secondary, #c4c7cc);\n  margin-top: 2px;\n}\n\n/* Sliders */\n.slider-group {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.slider-label-row {\n  display: flex;\n  justify-content: space-between;\n  font-size: 12px;\n  color: var(--app-text-secondary, #c4c7cc);\n}\n\n.slider-val {\n  font-weight: 700;\n  color: var(--app-accent, #8ab4f8);\n}\n\n.settings-slider {\n  width: 100%;\n  accent-color: var(--app-accent, #8ab4f8);\n  cursor: pointer;\n}\n\n/* Model Selector Grid */\n.model-selector-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 12px;\n  margin-top: 10px;\n}\n\n.model-card {\n  background: var(--app-surface-2, #22252c);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-base, 8px);\n  padding: 14px;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.model-card:hover {\n  border-color: var(--app-border-hover, #434957);\n}\n\n.model-card.active {\n  border-color: var(--app-accent, #8ab4f8);\n  background: var(--app-surface-3, #2e323b);\n  box-shadow: 0 0 14px var(--app-accent-glow, rgba(138, 180, 248, 0.3));\n}\n\n.model-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 6px;\n}\n\n.model-name {\n  font-size: 13px;\n  font-weight: 700;\n  color: var(--app-text-primary, #ffffff);\n}\n\n.model-speed-badge {\n  font-size: 9px;\n  font-weight: 700;\n  background: var(--app-accent, #8ab4f8);\n  color: #000000;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.model-desc {\n  font-size: 11px;\n  color: var(--app-text-secondary, #c4c7cc);\n  margin: 0;\n  line-height: 1.4;\n}\n\n.reset-all-btn {\n  padding: 8px 16px;\n  background: rgba(242, 139, 130, 0.12);\n  border: 1px solid var(--app-error, #f28b82);\n  border-radius: var(--app-radius-base, 8px);\n  color: var(--app-error, #f28b82);\n  font-size: 12px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n}\n\n.reset-all-btn:hover {\n  background: var(--app-error, #f28b82);\n  color: #000000;\n}\n\n/* Modal Footer */\n.settings-modal-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 14px 24px;\n  border-top: 1px solid var(--app-border, #2d313b);\n  background: var(--app-surface-2, #22252c);\n}\n\n.settings-footer-info {\n  font-size: 12px;\n  color: var(--app-text-secondary, #c4c7cc);\n}\n\n.settings-done-btn {\n  padding: 8px 24px;\n  background: var(--app-accent, #8ab4f8);\n  border: none;\n  border-radius: var(--app-radius-pill, 24px);\n  color: #000000;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n}\n\n.settings-done-btn:hover {\n  filter: brightness(1.1);\n  box-shadow: 0 0 12px var(--app-accent-glow, rgba(138, 180, 248, 0.35));\n}\n"
    }
