  file_change {
    absolute_path_uri: "file:///index.css"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "/* ==========================================\n   OUTER FRAME & APP SHELL\n   ========================================== */\n\n.outer-frame {\n  width: 100vw;\n  height: 100vh;\n  background: var(--app-bg, #000);\n  display: flex;\n  flex-direction: column;\n  padding: 16px 20px 10px;\n  box-sizing: border-box;\n  font-family: var(--app-font-family);\n  overflow: hidden;\n  position: relative;\n  transition: background-color 0.25s ease, color 0.25s ease;\n}\n\n/* Canvas Backdrop Textures */\n.canvas-texture-layer {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  pointer-events: none;\n  z-index: 0;\n  opacity: 0.6;\n}\n\n.canvas-texture-layer.pattern-dots {\n  background-image: radial-gradient(var(--app-border, #333) 1px, transparent 1px);\n  background-size: 24px 24px;\n}\n\n.canvas-texture-layer.pattern-grid {\n  background-image: linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),\n                    linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);\n  background-size: 32px 32px;\n}\n\n.canvas-texture-layer.pattern-vignette {\n  background: radial-gradient(circle at center, transparent 30%, rgba(0, 0, 0, 0.6) 100%);\n}\n\n.canvas-texture-layer.pattern-minimal {\n  display: none;\n}\n\n/* CSS-only zoom fallback (JS overrides with smooth linear scaling) */\n@media (min-height: 1081px) {\n  .outer-frame {\n    zoom: 1.25;\n    width: calc(100vw / 1.25);\n    height: calc(100vh / 1.25);\n    --effective-vh: calc(100vh / 1.25);\n  }\n}\n\n@media (min-height: 1300px) {\n  .outer-frame {\n    zoom: 1.5;\n    width: calc(100vw / 1.5);\n    height: calc(100vh / 1.5);\n    --effective-vh: calc(100vh / 1.5);\n  }\n}\n\n.outer-frame.maximized-view .main-container {\n  max-width: 100%;\n  max-height: calc(var(--effective-vh, 100vh) - 70px);\n}\n\n.outer-header {\n  flex-shrink: 0;\n  margin-bottom: 4px;\n  position: relative;\n  z-index: 2;\n}\n\n/* App Shell Topbar */\n.app-shell-topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  flex-wrap: wrap;\n  padding-bottom: 8px;\n}\n\n.app-shell-brand-group {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n/* Native Window Controls */\n.app-window-controls {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  background: var(--app-surface-1, #181a20);\n  border: 1px solid var(--app-border, #2d313b);\n  padding: 6px 9px;\n  border-radius: 20px;\n}\n\n.win-btn {\n  width: 11px;\n  height: 11px;\n  border-radius: 50%;\n  border: none;\n  cursor: pointer;\n  padding: 0;\n  transition: transform 0.15s ease, filter 0.15s ease;\n}\n\n.win-btn:hover {\n  transform: scale(1.15);\n  filter: brightness(1.2);\n}\n\n.win-close { background: #ff5f56; }\n.win-minimize { background: #ffbd2e; }\n.win-maximize { background: #27c93f; }\n\n.app-title-cluster {\n  display: flex;\n  align-items: baseline;\n  gap: 12px;\n}\n\n.outer-title {\n  font-size: 38px;\n  font-weight: 600;\n  color: var(--app-text-primary, #ffffff);\n  margin: 0;\n  letter-spacing: -0.5px;\n  line-height: 1.1;\n}\n\n.app-shell-status-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  background: var(--app-surface-2, #22252c);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-pill, 24px);\n  padding: 3px 9px;\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--app-text-secondary, #c4c7cc);\n}\n\n.app-pulse-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--app-success, #81c995);\n  box-shadow: 0 0 8px var(--app-success, #81c995);\n  animation: pulse 2s infinite ease-in-out;\n}\n\n/* App Shell Actions Cluster */\n.app-shell-actions-cluster {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n/* Quick Theme Button */\n.theme-quick-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  background: var(--app-surface-1, #181a20);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-pill, 24px);\n  padding: 6px 12px;\n  color: var(--app-text-secondary, #c4c7cc);\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n}\n\n.theme-quick-btn:hover {\n  background: var(--app-surface-2, #22252c);\n  border-color: var(--app-border-hover, #434957);\n  color: var(--app-text-primary, #fff);\n}\n\n.theme-swatch-dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  box-shadow: 0 0 6px currentColor;\n}\n\n/* Settings Gear Trigger Button */\n.app-settings-trigger-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  background: var(--app-surface-1, #181a20);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-pill, 24px);\n  padding: 6px 14px;\n  color: var(--app-text-primary, #ffffff);\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\n}\n\n.app-settings-trigger-btn:hover {\n  background: var(--app-surface-2, #22252c);\n  border-color: var(--app-accent, #8ab4f8);\n  color: var(--app-accent, #8ab4f8);\n  box-shadow: 0 0 12px var(--app-accent-glow, rgba(138, 180, 248, 0.35));\n}\n\n.outer-caption-row {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 20px;\n  margin-bottom: 12px;\n}\n\n.outer-caption {\n  font-size: 15px;\n  color: var(--app-text-secondary, #c4c7cc);\n  margin: 0;\n}\n\n.main-container {\n  flex: 1;\n  width: 100%;\n  max-height: calc(var(--effective-vh, 100vh) - 90px);\n  max-width: calc((var(--effective-vh, 100vh) - 90px) * 16 / 10);\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  position: relative;\n  z-index: 1;\n}\n\n.browser-container {\n  flex: 1;\n  width: 100%;\n  border-radius: var(--app-radius-card, 16px);\n  overflow: hidden;\n  box-shadow: var(--app-shadow, 0 4px 24px rgba(0, 0, 0, 0.6));\n  border: 1px solid var(--app-border, #444);\n  min-height: 0;\n  background: var(--app-canvas-bg, #0c0d10);\n  transition: border-color 0.25s ease, box-shadow 0.25s ease;\n}"
      replacement_content: "/* ==========================================\n   PRODUCTION APP SHELL & FULL VIEWPORT WORKSPACE\n   ========================================== */\n\n.app-shell-root {\n  width: 100vw;\n  height: 100vh;\n  background: var(--app-bg, #000);\n  display: flex;\n  flex-direction: column;\n  padding: 0;\n  margin: 0;\n  box-sizing: border-box;\n  font-family: var(--app-font-family);\n  overflow: hidden;\n  position: relative;\n  transition: background-color 0.25s ease, color 0.25s ease;\n}\n\n/* Backward compatibility wrapper */\n.outer-frame {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n/* Canvas Backdrop Textures */\n.canvas-texture-layer {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  pointer-events: none;\n  z-index: 0;\n  opacity: 0.4;\n}\n\n.canvas-texture-layer.pattern-dots {\n  background-image: radial-gradient(var(--app-border, #333) 1px, transparent 1px);\n  background-size: 24px 24px;\n}\n\n.canvas-texture-layer.pattern-grid {\n  background-image: linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),\n                    linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);\n  background-size: 32px 32px;\n}\n\n.canvas-texture-layer.pattern-vignette {\n  background: radial-gradient(circle at center, transparent 40%, rgba(0, 0, 0, 0.6) 100%);\n}\n\n.canvas-texture-layer.pattern-minimal {\n  display: none;\n}\n\n/* Top Production Navigation Bar */\n.app-shell-navbar {\n  height: 48px;\n  min-height: 48px;\n  background: var(--app-surface-1, #181a20);\n  border-bottom: 1px solid var(--app-border, #2d313b);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 16px;\n  gap: 12px;\n  z-index: 50;\n  flex-shrink: 0;\n}\n\n.app-shell-brand-section {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.app-brand-badge {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  user-select: none;\n}\n\n.app-brand-icon {\n  font-size: 20px;\n  color: var(--app-accent, #8ab4f8);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.app-brand-name {\n  font-size: 15px;\n  font-weight: 700;\n  color: var(--app-text-primary, #ffffff);\n  letter-spacing: -0.3px;\n}\n\n.app-version-pill {\n  font-size: 10px;\n  font-weight: 600;\n  padding: 1px 5px;\n  border-radius: 4px;\n  background: var(--app-surface-3, #2e323b);\n  color: var(--app-accent, #8ab4f8);\n  border: 1px solid var(--app-border, #333);\n}\n\n.app-live-status-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  background: var(--app-surface-2, #22252c);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: var(--app-radius-pill, 24px);\n  padding: 3px 8px;\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--app-text-secondary, #c4c7cc);\n}\n\n.app-pulse-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--app-success, #81c995);\n  box-shadow: 0 0 8px var(--app-success, #81c995);\n  animation: pulse 2s infinite ease-in-out;\n}\n\n/* Primary Application Mode Switcher */\n.app-mode-switcher-nav {\n  display: flex;\n  align-items: center;\n  background: var(--app-surface-2, #20232a);\n  border: 1px solid var(--app-border, #2e323b);\n  padding: 3px;\n  border-radius: 24px;\n  gap: 3px;\n}\n\n.app-mode-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 13px;\n  border-radius: 20px;\n  background: transparent;\n  border: none;\n  color: var(--app-text-secondary, #9aa0a6);\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n  white-space: nowrap;\n}\n\n.app-mode-pill:hover {\n  color: var(--app-text-primary, #fff);\n}\n\n.app-mode-pill.active {\n  background: var(--app-surface-1, #181a20);\n  color: var(--app-text-primary, #fff);\n  font-weight: 600;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);\n}\n\n.app-pill-badge {\n  font-size: 9px;\n  padding: 1px 4px;\n  border-radius: 3px;\n  background: rgba(56, 189, 248, 0.2);\n  color: #38bdf8;\n  font-weight: 700;\n}\n\n/* Actions Section */\n.app-shell-actions-section {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.app-token-badge {\n  display: flex;\n  align-items: center;\n  background: var(--app-surface-2, #22252c);\n  border: 1px solid var(--app-border, #2d313b);\n  border-radius: 20px;\n  padding: 3px 10px;\n  font-size: 12px;\n  color: var(--app-text-primary, #fff);\n}\n\n.app-tool-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 11px;\n  border-radius: 20px;\n  background: var(--app-surface-2, #22252c);\n  border: 1px solid var(--app-border, #2d313b);\n  color: var(--app-text-secondary, #c4c7cc);\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n}\n\n.app-tool-btn:hover {\n  background: var(--app-surface-3, #2e323b);\n  border-color: var(--app-border-hover, #434957);\n  color: var(--app-text-primary, #fff);\n}\n\n.app-tool-btn.icon-only {\n  padding: 5px 8px;\n}\n\n.app-settings-primary-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 13px;\n  border-radius: 20px;\n  background: var(--app-surface-3, #2e323b);\n  border: 1px solid var(--app-accent, #8ab4f8);\n  color: var(--app-text-primary, #ffffff);\n  font-size: 12px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  font-family: inherit;\n  box-shadow: 0 0 10px var(--app-accent-glow, rgba(138, 180, 248, 0.25));\n}\n\n.app-settings-primary-btn:hover {\n  background: var(--app-accent, #8ab4f8);\n  color: #121212;\n  box-shadow: 0 0 16px var(--app-accent-glow, rgba(138, 180, 248, 0.5));\n}\n\n/* Theme Swatch Dot */\n.theme-swatch-dot {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  box-shadow: 0 0 6px currentColor;\n}\n\n.theme-swatch-dot.small {\n  width: 8px;\n  height: 8px;\n}\n\n/* Full Viewport Main Workspace */\n.app-workspace-main {\n  flex: 1;\n  min-height: 0;\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  position: relative;\n  z-index: 1;\n}\n\n.browser-container {\n  flex: 1;\n  width: 100%;\n  height: 100%;\n  border-radius: 0;\n  overflow: hidden;\n  box-shadow: none;\n  border: none;\n  min-height: 0;\n  background: var(--app-canvas-bg, #0c0d10);\n  display: flex;\n  flex-direction: column;\n}\n\n/* Modern Integrated Status Bar */\n.app-shell-statusbar {\n  height: 26px;\n  min-height: 26px;\n  background: var(--app-surface-1, #14161b);\n  border-top: 1px solid var(--app-border, #252830);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 14px;\n  font-size: 11px;\n  color: var(--app-text-secondary, #9aa0a6);\n  z-index: 40;\n  flex-shrink: 0;\n  font-family: var(--app-font-family);\n  user-select: none;\n}\n\n.statusbar-left,\n.statusbar-center,\n.statusbar-right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.status-item {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n}\n\n.status-sep {\n  color: var(--app-border, #2d313b);\n  font-size: 10px;\n}\n\n.status-indicator-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n}\n\n.status-indicator-dot.online {\n  background: var(--app-success, #81c995);\n  box-shadow: 0 0 6px var(--app-success, #81c995);\n}\n\n.statusbar-theme-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  background: transparent;\n  border: none;\n  color: var(--app-text-secondary, #c4c7cc);\n  font-size: 11px;\n  cursor: pointer;\n  padding: 1px 4px;\n  border-radius: 4px;\n  font-family: inherit;\n  transition: color 0.15s ease;\n}\n\n.statusbar-theme-btn:hover {\n  color: var(--app-text-primary, #fff);\n}\n\n.status-pill-subtle {\n  font-size: 10px;\n  font-weight: 600;\n  color: var(--app-success, #81c995);\n  background: rgba(129, 201, 149, 0.12);\n  padding: 1px 5px;\n  border-radius: 3px;\n}"
    }
