{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentsamfast-edge",
  "main": "server.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ACP_CLIENT_ID": "iam_dcr_d80b0615148b49de814f",
    "IAM_CLIENT_ID": "iam_identity_47843d145d72455e83b6"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inneranimalmedia-business",
      "database_id": "cf87b717-d4e2-4cf8-bab0-a81268e32d49",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AgentSam",
        "class_name": "agentsamremix_AgentSam"
      },
      {
        "name": "MY_CONTAINER",
        "class_name": "agentsamremix_Sandbox"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SESSION_CACHE",
      "id": "production-KV_SESSIONS"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "inneranimalmedia"
    },
    {
      "binding": "WEBSITE_ASSETS",
      "bucket_name": "agentsam-os-blueprint-content"
    }
  ],
  "services": [
    {
      "binding": "EXECOS",
      "service": "execos"
    },
    {
      "binding": "PTY_SERVICE",
      "service": "iam-vpc"
    }
  ],
  "ai": {
    "binding": "AGENTSAM_WAI"
  },
  "browser": {
    "binding": "MYBROWSER"
  }
}
