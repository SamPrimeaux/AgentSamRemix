{
  "name": "@inneranimalmedia/cms-cloudflare-template-library",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable IAM CMS application and public-site blocks built on Cloudflare-friendly primitives.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js"
    },
    "./registry/component-registry.json": "./src/registry/component-registry.json",
    "./registry/template-registry.json": "./src/registry/template-registry.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@cloudflare/kumo": "^2.12.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
